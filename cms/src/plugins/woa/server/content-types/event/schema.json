{
  "kind": "collectionType",
  "collectionName": "woa_events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Analytics event"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "kind": {
      "type": "enumeration",
      "enum": [
        "pageview",
        "download",
        "outbound",
        "video",
        "search",
        "notfound"
      ],
      "default": "pageview"
    },
    "path": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "lang": {
      "type": "string"
    },
    "referrer": {
      "type": "string"
    },
    "visitor": {
      "type": "string"
    },
    "session": {
      "type": "string"
    },
    "duration": {
      "type": "integer",
      "default": 0
    },
    "device": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "day": {
      "type": "string"
    },
    "eid": {
      "type": "string"
    },
    "from_path": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "browser": {
      "type": "string"
    },
    "os": {
      "type": "string"
    },
    "screen": {
      "type": "string"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "first_visit": {
      "type": "boolean",
      "default": false
    },
    "scroll": {
      "type": "integer"
    },
    "lcp": {
      "type": "integer"
    },
    "cls": {
      "type": "integer"
    },
    "inp": {
      "type": "integer"
    },
    "results": {
      "type": "integer"
    },
    "hour": {
      "type": "integer"
    },
    "weekday": {
      "type": "integer"
    }
  }
}
