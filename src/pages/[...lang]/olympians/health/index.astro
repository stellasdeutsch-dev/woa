---
import * as cheerio from 'cheerio';
import Base from '../../../../layouts/Base.astro';
import PageHero from '../../../../components/PageHero.astro';
import { dataFor } from '../../../../lib/data';
import { LANG_PARAMS, pageLang, t as tFor, L as Lx } from '../../../../lib/i18n';
export function getStaticPaths() { return LANG_PARAMS; }
const lang = pageLang(Astro.params); const tr = tFor(lang); const D = dataFor(lang);
const page = D.page;
import { b, prose } from '../../../../lib/site';

const p = page('/olympians/health/');
const $ = cheerio.load(b(p.body), null, false);
const ps = $.root().children('p');
const intro = $.html(ps.eq(0));
const scale = ps.eq(1).text().trim();
// "more than 3000 retired Olympians from 131 countries, representing 57 Olympic sports"
import { sections } from '../../../../lib/sections';
import { navLabel } from '../../../../lib/i18n';
// three numbers from that sentence, with the words that follow each one (in the page's language)
const stats = sections(lang).OLYMPIANS.health.stats;
// "Key findings include:" — the paragraph right before the list
const findingsHead = $('ul').first().prevAll('p').first().text().trim();
const findings = $('ul li').map((_, li) => $(li).text().trim()).get();
const pct = (s: string) => [...s.matchAll(/(\d+(?:\.\d+)?)%/g)].map(x => parseFloat(x[1]));
const injury = findings.find(f => /knee/.test(f)) || '';
const injuryParts = [...injury.matchAll(/(knee|lumbar spine|shoulder\/clavicle) \((\d+(?:\.\d+)?)%\)/g)].map(x => ({ label: x[1], v: parseFloat(x[2]) }));
const gender = findings.find(f => /Female/.test(f)) || '';
const g = gender.match(/Female injury \((\d+(?:\.\d+)?)%\).*male \((\d+(?:\.\d+)?)%\)/);
const kids = $.root().children().toArray(); const ulIdx = kids.findIndex(e => (e as any).tagName === 'ul');
const rest = kids.slice(ulIdx >= 0 ? ulIdx + 1 : 3).map(e => $.html(e)).join('');
const { html: restHtml } = prose(rest);
---
<Base title={p.title} origPath={p.orig} image={b(p.bg)}>
  <PageHero title={p.title} crumbs={[{ label: navLabel('/olympians/', 'Olympians', lang), href: '/olympians/' }, { label: 'Health' }]} bg={b(p.bg)} />
  <section class="section">
    <div class="container">
      <div class="prose lead-p" set:html={intro} />
      {stats.length === 3 && (
        <dl class="h-stats">
          {stats.map(([n, label], i) => <div><dt class="stat-num">{n}{i === 0 ? '+' : ''}</dt><dd class="stat-label">{label}</dd></div>)}
        </dl>
      )}
      <p class="scale">{scale}</p>
    </div>
  </section>
  <section class="section bg-grey">
    <div class="container">
      <div class="section-head"><h2>{findingsHead}</h2></div>
      <div class="findings">
        {findings.filter(f => f !== injury && f !== gender).map(f => { const nums = pct(f); return (
          <figure class="finding">
            {nums.length > 0 ? <div class="rings">{nums.map(n => <svg class="donut" viewBox="0 0 42 42" aria-hidden="true"><circle cx="21" cy="21" r="15.9" class="d-bg" /><circle cx="21" cy="21" r="15.9" class="d-fg" style={`stroke-dasharray:${n} ${100 - n}`} /><text x="21" y="23.5">{n}%</text></svg>)}</div>
              : <svg class="icon icon-xl q-icon"><use href="#i-check" /></svg>}
            <figcaption>{f}</figcaption>
          </figure>); })}
      </div>
      <div class="findings findings-bars">
        {injuryParts.length > 0 && (
          <figure class="finding">
            <svg class="icon icon-lg q-icon"><use href="#i-chart" /></svg>
            <figcaption>{injury}</figcaption>
            <div class="bars">{injuryParts.map(x => <div class="bar-row"><span class="bar-label">{x.label}</span><span class="bar"><span style={`width:${(x.v / Math.max(...injuryParts.map(y => y.v))) * 100}%`}></span></span><span class="bar-v fact">{x.v}%</span></div>)}</div>
          </figure>
        )}
        {g && (
          <figure class="finding">
            <svg class="icon icon-lg q-icon"><use href="#i-chart" /></svg>
            <figcaption>{gender}</figcaption>
            <div class="bars"><div class="bar-row"><span class="bar-label">Female</span><span class="bar"><span style={`width:${g[1]}%`}></span></span><span class="bar-v fact">{g[1]}%</span></div><div class="bar-row"><span class="bar-label">Male</span><span class="bar"><span style={`width:${g[2]}%`}></span></span><span class="bar-v fact">{g[2]}%</span></div></div>
          </figure>
        )}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose" set:html={restHtml} />
  </section>
</Base>
<style>
  .lead-p { font-size: var(--fs-lead); line-height: 1.55; }
  .h-stats { display: grid; gap: var(--sp-4); grid-template-columns: minmax(0, 1fr); margin: var(--sp-7) 0 var(--sp-5); }
  @media (min-width: 640px) { .h-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .h-stats > div { padding: var(--sp-6); background: var(--c-black); color: var(--c-white); border-radius: var(--radius-lg); }
  .h-stats dd { margin: var(--sp-3) 0 0; color: var(--c-grey-400) !important; }
  .scale { color: var(--c-grey-700); }
  .findings { display: grid; gap: var(--sp-4); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 834px) { .findings { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .findings { grid-template-columns: repeat(4, minmax(0, 1fr)); } .findings-bars { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .findings-bars { margin-top: var(--sp-4); }
  .finding { margin: 0; display: grid; gap: var(--sp-4); align-content: start; padding: var(--sp-6); background: var(--c-white); border: 1px solid var(--c-grey-200); border-radius: var(--radius-lg); transition: border-color var(--t); }
  .finding:hover { border-color: var(--c-black); }
  .finding figcaption { font-weight: 600; line-height: 1.45; }
  .rings { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .donut { width: 96px; height: 96px; }
  .d-bg { fill: none; stroke: var(--c-grey-200); stroke-width: 4; }
  .d-fg { fill: none; stroke: var(--c-gold); stroke-width: 4; stroke-dashoffset: 25; stroke-linecap: butt; }
  .donut text { font: 700 8px var(--font); text-anchor: middle; fill: var(--c-black); }
  .q-icon { color: var(--c-gold); }
  .bars { display: grid; gap: var(--sp-3); }
  .bar-row { display: grid; grid-template-columns: 130px minmax(0, 1fr) 64px; align-items: center; gap: var(--sp-3); font-size: var(--fs-small); }
  .bar { height: 14px; background: var(--c-grey-100); border-radius: 999px; overflow: hidden; }
  .bar > span { display: block; height: 100%; background: var(--c-gold); border-radius: 999px; }
  .bar-v { justify-self: end; }
  @media (max-width: 480px) { .bar-row { grid-template-columns: 1fr 56px; } .bar { grid-column: 1 / -1; grid-row: 2; } }
</style>
