---
// Olympians section landing. Sentences come from OLY, Olympian.org Email, Health, Olympians for Life, SkillsBuild, WOF, OLY House.
import Base from '../../../layouts/Base.astro';
import SectionHero from '../../../components/landing/SectionHero.astro';
import { sections } from '../../../lib/sections';
import { LANG_PARAMS, pageLang, t } from '../../../lib/i18n';
export function getStaticPaths() { return LANG_PARAMS; }
const lang = pageLang(Astro.params);
const SX = sections(lang);
const L = SX.OLYMPIANS;
import { url, b, srcset, phColor, words } from '../../../lib/site';
const s = SX.SECTIONS.find(x => x.key === 'olympians')!;
const rows = [L.email, L.life, L.skills];
// the first sentence of each page's opening paragraph (the full text is on the page itself)
const firstSentence = (t: string) => (t.match(/^.+?[.!?](?=\s+[A-ZÀ-ÖØ-Þ¿¡«“"]|$)/) || [t])[0];
---
<Base title={s.title} image={b(s.img)} description={s.lead}>
  <SectionHero s={s} />

  <section class="section bg-dark ld-oly">
    <div class="container ld-oly-inner">
      <figure class="ld-oly-mark"><img src={b('{{BASE}}/backgrounds/94.webp')} alt="Be OLY" loading="lazy" /></figure>
      <div class="ld-copy">
        <h2>{L.oly.title}</h2>
        <p class="ld-statement-sm scrub" set:html={words(L.oly.ps[0])} />
        <p class="muted-light">{L.oly.ps[1]}</p>
        <p class="muted-light">{L.oly.ps[2]}</p>
        <a class="btn btn-gold" href={url(L.oly.href)}><svg class="icon"><use href="#i-oly" /></svg>{L.oly.title}</a>
      </div>
    </div>
  </section>

  <section class="section bg-grey">
    <div class="container">
      <ul class="ld-offers">
        {rows.map(r => (
          <li><a class="ld-offer" href={url(r.href)}>
            <span class="ld-offer-photo"><img src={b(r.img)} srcset={srcset(r.img)} style={phColor(r.img)} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" alt="" loading="lazy" /></span>
            <span class="ld-offer-body">
              <strong class="ld-offer-title">{r.title}</strong>
              <span class="ld-offer-text">{'head' in r ? (r as any).head : firstSentence(r.text)}</span>
              <svg class="icon ld-offer-arrow"><use href="#i-arrow" /></svg>
            </span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-dark">
    <div class="container">
      <div class="ld-health">
        <div class="ld-copy">
          <h2>{L.health.title}</h2>
          <p class="lead">{L.health.text}</p>
          <a class="btn btn-gold" href={url(L.health.href)}><svg class="icon"><use href="#i-health" /></svg>{L.health.title}</a>
        </div>
        <dl class="ld-stats">
          {L.health.stats.map(([n, t]) => <div><dt class="big-num" data-count={n}>{n}</dt><dd>{t}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container ld-pair">
      {[L.wof, L.house].map(r => (
        <a class="ld-tile" href={url(r.href)}>
          <span class="ld-tile-photo"><img src={b(r.img)} srcset={srcset(r.img)} style={phColor(r.img)} sizes="(min-width: 834px) 50vw, 100vw" alt="" loading="lazy" /></span>
          <span class="ld-tile-body"><strong>{r.title}</strong><span>{r.text}</span><svg class="icon"><use href="#i-arrow" /></svg></span>
        </a>
      ))}
    </div>
  </section>
</Base>
