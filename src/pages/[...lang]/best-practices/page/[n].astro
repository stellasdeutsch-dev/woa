---
import Base from '../../../../layouts/Base.astro';
import StoryList from '../../../../components/templates/StoryList.astro';
import { dataFor } from '../../../../lib/data';
import { b } from '../../../../lib/site';
import { LANGS, langParam, pageLang, navLabel } from '../../../../lib/i18n';
export function getStaticPaths() {
  return LANGS.flatMap(l => { const n = Math.ceil((dataFor(l).practices.length - 1) / 18); return Array.from({ length: n - 1 }, (_, k) => ({ params: { lang: langParam(l), n: String(k + 2) } })); });
}
const lang = pageLang(Astro.params);
const all = dataFor(lang).practices;
const PER = 18;
const n = Number(Astro.params.n);
const items = all.slice(1 + (n - 1) * PER, 1 + n * PER);
const title = navLabel('/best-practices/', 'Best Practices', lang);
---
<Base title={`${title} – ${n}`} type="Page" search={false}>
  <StoryList title={title} base="/best-practices/" all={all} items={items} page={n} pages={Math.ceil((all.length - 1) / PER)} bg={b(all[0].img)} />
</Base>
