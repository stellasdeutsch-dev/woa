---
// NOAs section landing. Sentences come from About, NOA Guide, Grants; flags from the NOA Directory.
import Base from '../../../layouts/Base.astro';
import SectionHero from '../../../components/landing/SectionHero.astro';
import StoryCard from '../../../components/StoryCard.astro';
import { sections } from '../../../lib/sections';
import { LANG_PARAMS, pageLang, t } from '../../../lib/i18n';
export function getStaticPaths() { return LANG_PARAMS; }
const lang = pageLang(Astro.params);
const SX = sections(lang);
const L = SX.NOAS;
import { url, b, srcset, phColor, words, realFlag } from '../../../lib/site';
const s = SX.SECTIONS.find(x => x.key === 'noas')!;
const GUIDE_ICON: Record<string, string> = { 'Member Engagement': 'friendship', 'Branding & Marketing': 'design', 'Project Delivery': 'target', 'Leadership & Governance': 'leadership', 'Finance Management': 'grant', 'Stakeholder Engagement': 'alliance', 'Best Practices': 'practice' };
---
<Base title={s.title} image={b(s.img)} description={s.lead}>
  <SectionHero s={s} />

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{L.directory.title}</h2><a class="link-arrow" href={url(L.directory.href)}>{L.directory.title}<svg class="icon"><use href="#i-arrow" /></svg></a></div>
      <ul class="ld-flags">
        {L.directory.flags.map(f => <li><a href={url(`${L.directory.href}#noa-${f.code}`)}><span class="ld-flag-img">{realFlag(f.code) && <img src={realFlag(f.code)!.src} alt="" loading="lazy" width={realFlag(f.code)!.w} height={realFlag(f.code)!.h} />}</span><span class="ld-flag-name">{f.country}</span></a></li>)}
      </ul>
      <a class="btn btn-outline ld-flags-all" href={url(L.directory.href)}>{L.directory.title}<svg class="icon icon-arrow"><use href="#i-arrow" /></svg></a>
    </div>
  </section>

  <section class="section bg-grey">
    <div class="container ld-row">
      <figure class="ld-media"><img src={b(L.guide.img)} srcset={srcset(L.guide.img)} style={phColor(L.guide.img)} sizes="(min-width: 1024px) 55vw, 100vw" alt="" loading="lazy" /></figure>
      <div class="ld-copy">
        <h2>{L.guide.title}</h2>
        <p class="lead">{L.guide.text}</p>
        <a class="btn" href={url(L.guide.href)}>{L.guide.title}<svg class="icon icon-arrow"><use href="#i-arrow" /></svg></a>
      </div>
    </div>
    <div class="container">
      <ol class="ld-chapters">
        {L.guide.chapters.map((c, i) => <li><a href={url(c.href)}><span class="ld-ch-mark"><svg class="icon"><use href={`#i-${GUIDE_ICON[c.key] ?? 'guide'}`} /></svg><span class="ld-ch-num">{i + 1}</span></span><span>{c.label}</span></a></li>)}
      </ol>
    </div>
  </section>

  <section class="section bg-dark">
    <div class="container ld-grants">
      <div class="ld-copy">
        <h2>{L.grants.title}</h2>
        <p class="ld-statement-sm scrub" set:html={words(L.grants.text)} />
        <a class="btn btn-gold" href={url(L.grants.href)}><svg class="icon"><use href="#i-grant" /></svg>{L.grants.title}</a>
      </div>
      <ul class="ld-grant-list">
        {L.grants.items.map(g => <li><strong>{g.amount}</strong>{g.label && <span>{g.label}</span>}</li>)}
      </ul>
    </div>
    {L.grants.dates.items.length > 0 && (
      <div class="container ld-dates-wrap">
        <h3 class="ld-dates-title">{L.grants.dates.title}</h3>
        <ol class="ld-dates">
          {L.grants.dates.items.map(d => <li><svg class="icon"><use href="#i-calendar" /></svg><span class="ld-date">{d.when}</span><span class="ld-date-what">{d.what}</span></li>)}
        </ol>
      </div>
    )}
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{L.practices.title}</h2><a class="link-arrow" href={url(L.practices.href)}>{L.practices.title}<svg class="icon"><use href="#i-arrow" /></svg></a></div>
      <div class="grid grid-3">{L.practices.items.map(n => <StoryCard item={n} />)}</div>
    </div>
  </section>
</Base>
