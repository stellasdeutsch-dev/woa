---
import * as cheerio from 'cheerio';
import Base from '../../../../layouts/Base.astro';
import PageHero from '../../../../components/PageHero.astro';
import Tabs from '../../../../components/Tabs.astro';
import Docs from '../../../../components/Docs.astro';
import { dataFor } from '../../../../lib/data';
import { LANG_PARAMS, pageLang, t as tFor, L as Lx } from '../../../../lib/i18n';
export function getStaticPaths() { return LANG_PARAMS; }
const lang = pageLang(Astro.params); const tr = tFor(lang); const D = dataFor(lang);
const page = D.page;
import { sections } from '../../../../lib/sections';
import { navLabel, stripLang as stripL, fmtNum } from '../../../../lib/i18n';
const enValues = cheerio.load(dataFor('en').page('/woa/about/values/').body)('h2').map((_, h) => cheerio.load(h).text().trim()).get();
// tab labels of the About page in the page's language ("Buts", "Valeurs", "Historique" …)
const tab = (enPath: string, en: string) => page('/woa/about/').tabs.find(x => stripL(x.href.replace('{{BASE}}', '')) === enPath)?.label ?? en;
const aboutTitle = navLabel('/woa/about/', 'About', lang);
const STATS = sections(lang).STATS;
const loc = (h: string) => url(Lx(h, lang));
import { b, url, prose, BASE } from '../../../../lib/site';

const p = page('/woa/about/');
const $ = cheerio.load(p.body);
const leadText = $('h2').first().text().trim();
const paras = $('p').map((_, el) => $(el).text().trim()).get().filter(Boolean);
const video = (p.body.match(/data-yt="([\w-]+)"/) || [])[1];
const { html: videoBlock } = prose(video ? `<div class="video" data-yt="${video}"></div>` : '', { lang });
const mission = cheerio.load(page('/woa/about/mission/').body)('h2').first().text().trim();
const vision = cheerio.load(page('/woa/about/vision/').body)('h2').first().text().trim();
const goals = cheerio.load(page('/woa/about/goals/').body).text().split(/\s*\d+\.\s+/).map(s => s.trim()).filter(Boolean);
const values = cheerio.load(page('/woa/about/values/').body)('h2').map((_, h) => cheerio.load(h).text().trim()).get();
const VALUE_ICONS: Record<string, string> = { Excellence: 'excellence', Integrity: 'integrity', Respect: 'respect', Friendship: 'friendship', Solidarity: 'solidarity', Inspiration: 'inspiration' };
// History: first and latest milestone years for the teaser
const hist = cheerio.load(page('/woa/about/history/').body);
const years = hist('p strong').map((_, s) => hist(s).text().trim()).get().filter(t => /^\d{4}$/.test(t));
const stat1 = leadText.match(/over ([\d,]+) living Olympians/);
const stat2 = paras[0]?.match(/There are (\d+) National Olympians Associations/);
const facts = (s: string) => s.replace(/(over [\d,]+ living Olympians|\d+ National Olympians Associations \(NOAs\))/g, '<strong class="fact">$1</strong>');
---
<Base title={aboutTitle} origPath={p.orig} image={b(p.bg)}>
  <PageHero title={aboutTitle} crumbs={[{ label: 'WOA', href: '/woa/' }, { label: aboutTitle }]} bg={b(p.bg)} lead={leadText} />
  <Tabs tabs={p.tabs} current={BASE + Lx('/woa/about/', lang)} />

  <section class="story story-steps" data-story="steps">
    <div class="story-stage">
      <figure class="ss-media" aria-hidden="true"><img src={b(p.bg)} alt="" loading="lazy" /></figure>
      <div class="container ss-copy prose">
        <h2 class="sr-only">Introduction</h2>
        {paras.map(t => <p class="ss-step" data-step set:html={facts(t)} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-intro">
      <aside class="about-side">
        <dl class="about-stats">
          {STATS.map((st, i) => <div><dt class="stat-num">{fmtNum(+st.n, lang)}{i === 0 ? '+' : ''}</dt><dd class="stat-label">{st.text}</dd></div>)}
        </dl>
        <Docs items={p.downloads} />
      </aside>
    </div>
    {video && <div class="container about-video" set:html={videoBlock} />}
  </section>

  <section class="section bg-dark">
    <div class="container mv">
      <a class="mv-card" href={loc('/woa/about/mission/')}>
        <span class="mv-head"><svg class="icon icon-lg"><use href="#i-mission" /></svg><h2>{tab('/woa/about/mission/', 'Mission')}</h2></span>
        <p>{mission}</p>
      </a>
      <a class="mv-card" href={loc('/woa/about/vision/')}>
        <span class="mv-head"><svg class="icon icon-lg"><use href="#i-vision" /></svg><h2>{tab('/woa/about/vision/', 'Vision')}</h2></span>
        <p>{vision}</p>
      </a>
    </div>
  </section>

  <section class="story story-stack" data-story="stack">
    <div class="container story-stage section">
      <div class="section-head"><h2>{tab('/woa/about/goals/', 'Goals')}</h2><a class="link-arrow" href={loc('/woa/about/goals/')}>{tab('/woa/about/goals/', 'Goals')}<svg class="icon"><use href="#i-arrow" /></svg></a></div>
      <ol class="goals">
        {goals.map((g, i) => <li data-step><span class="goal-num">{i + 1}</span><p>{g}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="bg-grey story story-spot" data-story="spotlight">
    <div class="container story-stage section">
      <span class="sp-shape" aria-hidden="true"></span>
      <div class="section-head"><h2>{tab('/woa/about/values/', 'Values')}</h2><a class="link-arrow" href={loc('/woa/about/values/')}>{tab('/woa/about/values/', 'Values')}<svg class="icon"><use href="#i-arrow" /></svg></a></div>
      <ul class="values">
        {values.map((v, i) => <li data-step><svg class="icon icon-xl"><use href={`#i-${VALUE_ICONS[enValues[i]] ?? 'values'}`} /></svg><h3>{v}</h3></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <a class="history-banner" href={loc('/woa/about/history/')}>
        <svg class="icon icon-xl"><use href="#i-history" /></svg>
        <div><h2>{tab('/woa/about/history/', 'History')}</h2><p class="hist-years"><span>{years[0]}</span><span class="hist-line" aria-hidden="true"></span><span>{years.at(-1)}</span></p></div>
        <span class="link-arrow">{tab('/woa/about/history/', 'History')}<svg class="icon"><use href="#i-arrow" /></svg></span>
      </a>
    </div>
  </section>
</Base>

<style>
  .about-intro { display: grid; gap: var(--sp-7); grid-template-columns: minmax(0, 1fr); }
  .about-side { display: grid; gap: var(--sp-6); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1024px) { .about-side { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); align-items: start; } }
  .about-stats { display: grid; gap: var(--sp-4); margin: 0; }
  @media (min-width: 640px) { .about-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .about-stats > div { padding: var(--sp-6); background: var(--c-grey-50); border-radius: var(--radius-lg); }
  .about-stats dd { margin: var(--sp-3) 0 0; }
  .about-video { margin-top: var(--sp-8); }
  .mv { display: grid; gap: var(--sp-5); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 834px) { .mv { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .mv-card { display: grid; gap: var(--sp-5); align-content: start; padding: clamp(24px, 4vw, 48px); border: 1px solid #333; border-radius: var(--radius-lg); transition: border-color var(--t), background var(--t); }
  .mv-card:hover { border-color: var(--c-gold); background: var(--c-ink); }
  .mv-head { display: flex; align-items: center; gap: var(--sp-4); color: var(--c-gold); }
  .mv-head h2 { color: var(--c-white); font-size: var(--fs-h3); }
  .mv-card p { font-size: var(--fs-h3); font-weight: 600; line-height: 1.35; }
  .story:not(.story-on) .goals { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-4); grid-template-columns: minmax(0, 1fr); counter-reset: g; }
  @media (min-width: 640px) { .story:not(.story-on) .goals { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .story:not(.story-on) .goals { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .story:not(.story-on) .goals li { display: grid; gap: var(--sp-4); align-content: start; padding: var(--sp-5); border: 1px solid var(--c-grey-200); border-radius: var(--radius-lg); transition: border-color var(--t), transform var(--t); }
  .story:not(.story-on) .goals li:hover { border-color: var(--c-black); transform: translateY(-2px); }
  .story:not(.story-on) .goal-num { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--c-gold); color: var(--c-black); font-weight: 700; font-size: 1.25rem; line-height: 1; }
  .story:not(.story-on) .goals p { font-weight: 600; line-height: 1.4; hyphens: manual; }
  .story:not(.story-on) .values { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-4); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 834px) { .story:not(.story-on) .values { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .story:not(.story-on) .values { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .story:not(.story-on) .values li { display: grid; justify-items: center; gap: var(--sp-4); padding: var(--sp-6) var(--sp-4); background: var(--c-white); border: 1px solid var(--c-grey-200); border-radius: var(--radius-lg); text-align: center; transition: border-color var(--t), transform var(--t); }
  .story:not(.story-on) .values li:hover { border-color: var(--c-black); transform: translateY(-2px); }
  .story:not(.story-on) .values .icon { color: var(--c-gold); }
  .story:not(.story-on) .values h3 { font-size: var(--fs-h4); }
  .history-banner { display: grid; gap: var(--sp-5); align-items: center; grid-template-columns: minmax(0, 1fr); padding: clamp(24px, 4vw, 48px); border: 1px solid var(--c-grey-200); border-radius: var(--radius-lg); transition: border-color var(--t), box-shadow var(--t); }
  @media (min-width: 834px) { .history-banner { grid-template-columns: auto minmax(0, 1fr) auto; gap: var(--sp-7); } }
  .history-banner:hover { border-color: var(--c-black); box-shadow: var(--shadow); }
  .history-banner .icon-xl { color: var(--c-gold); }
  .history-banner h2 { font-size: var(--fs-h2); }
  .hist-years { display: flex; align-items: center; gap: var(--sp-4); margin-top: var(--sp-3); font-size: var(--fs-h3); font-weight: 700; }
  .hist-line { flex: 1; max-width: 240px; height: 2px; background: var(--c-gold); }
</style>
