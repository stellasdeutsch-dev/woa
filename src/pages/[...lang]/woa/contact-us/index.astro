---
import Base from '../../../../layouts/Base.astro';
import PageHero from '../../../../components/PageHero.astro';
import { dataFor } from '../../../../lib/data';
import { LANG_PARAMS, pageLang, t as tFor, L as Lx } from '../../../../lib/i18n';
export function getStaticPaths() { return LANG_PARAMS; }
const lang = pageLang(Astro.params); const tr = tFor(lang); const D = dataFor(lang);
const page = D.page;
import { b, url, EMAIL, SOCIAL } from '../../../../lib/site';
const p = page('/woa/contact-us/');
---
<Base title={p.title} origPath={p.orig} image={b(p.bg)}>
  <PageHero title={p.title} crumbs={[{ label: 'WOA', href: '/woa/' }, { label: p.title }]} bg={b(p.bg)} compact />
  <section class="section">
    <div class="container contact">
      <div class="form-card prose" set:html={b(p.body)} />
      <aside class="aside">
        <a class="c-card" href={`mailto:${EMAIL}`}><span class="topic-icon"><svg class="icon icon-lg"><use href="#i-mail" /></svg></span><span><span class="c-label">Email</span><span class="c-val">{EMAIL}</span></span></a>
        {SOCIAL.map(s => <a class="c-card" href={s.href} target="_blank" rel="noopener"><span class="topic-icon"><svg class="icon icon-lg"><use href={`#i-${s.icon}`} /></svg></span><span><span class="c-label">{s.label}</span><span class="c-val">{s.href.replace(/^https?:\/\/(www\.)?/, '')}</span></span></a>)}
        <a class="c-card" href={url('/noas/noa-directory/')}><span class="topic-icon"><svg class="icon icon-lg"><use href="#i-directory" /></svg></span><span><span class="c-label">NOAs</span><span class="c-val">NOA Directory</span></span></a>
      </aside>
    </div>
  </section>
</Base>
<style>
  .contact { display: grid; gap: var(--sp-7); grid-template-columns: minmax(0, 1fr); align-items: start; }
  @media (min-width: 1024px) { .contact { grid-template-columns: minmax(0, 1fr) 380px; gap: var(--sp-8); } }
  .c-card { display: flex; gap: var(--sp-4); align-items: center; padding: var(--sp-5); border: 1px solid var(--c-grey-200); border-radius: var(--radius-lg); transition: border-color var(--t), background var(--t); }
  .c-card:hover { border-color: var(--c-black); background: var(--c-grey-50); }
  .c-card .topic-icon { display: inline-grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; border: 1.5px solid var(--c-gold); flex: none; }
  .c-label { display: block; font-size: var(--fs-xs); font-weight: 600; color: var(--c-grey-600); }
  .c-val { display: block; font-weight: 700; overflow-wrap: anywhere; }
</style>
