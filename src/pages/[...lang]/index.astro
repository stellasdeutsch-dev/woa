---
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import { dataFor } from '../../lib/data';
import { url, b, srcset, phColor, words, imgOk } from '../../lib/site';
import { sections } from '../../lib/sections';
import { LANG_PARAMS, pageLang, t, L, navLabel, fmtDateL, fmtNum } from '../../lib/i18n';
export function getStaticPaths() { return LANG_PARAMS; }

// All copy below is taken verbatim from olympians.org pages (in the page's language).
const lang = pageLang(Astro.params); const tr = t(lang);
const D = dataFor(lang); const SX = sections(lang);
const loc = (h: string) => url(L(h, lang));
const [lead, ...latest] = D.news;
const [heroLine, heroRest] = (() => { const m = SX.ABOUT_LEAD.match(/^(.*?\.)\s+(.*)$/); return m ? [m[1], m[2]] : [SX.ABOUT_LEAD, '']; })();
const doors = ['olympians', 'noas', 'woa'].map(k => SX.SECTIONS.find(s => s.key === k)!);
const more = latest.slice(0, 3);
const OLY = SX.OLYMPIANS.oly;
const newsLabel = navLabel('/news/', 'News', lang);
// ways to take part: links and their labels as they already appear on the site
const SUBMIT = { en: 'To submit a best practice, click here', fr: 'Pour soumettre une bonne pratique, cliquez ici', es: 'Para enviar una buena práctica, haz click aquí' }[lang];
const ACTIONS = [
  { href: '/olympians/oly/', icon: 'oly', label: OLY.title, tone: 'gold' },
  { href: '/noas/noa-directory/', icon: 'directory', label: navLabel('/noas/noa-directory/', 'NOA Directory', lang), tone: 'black' },
  { href: '/noas/grants/', icon: 'grant', label: navLabel('/noas/grants/', 'Grants', lang), tone: 'ink' },
  { href: '/best-practices/submissions/', icon: 'practice', label: SUBMIT, tone: 'light' },
];
---
<Base title={tr.org} type="Page">
  <!-- 1. Opening: one sentence, full screen -->
  <section class="hero home-open">
    <div class="hero-bg"><img src={b('{{BASE}}/backgrounds/47.webp')} srcset={srcset('{{BASE}}/backgrounds/47.webp')} style={phColor('{{BASE}}/backgrounds/47.webp')} sizes="100vw" alt="" fetchpriority="high" /></div>
    <div class="container home-open-inner">
      <h1 class="home-open-title" set:html={words(heroLine)} />
      {heroRest && <p class="home-open-lead">{heroRest}</p>}
      <div class="hero-actions">
        <a class="btn btn-gold btn-lg" href={loc('/olympians/oly/')}><svg class="icon"><use href="#i-oly" /></svg>{OLY.title}</a>
        <a class="btn btn-outline btn-lg" href={loc('/woa/')}>WOA<svg class="icon icon-arrow"><use href="#i-arrow" /></svg></a>
      </div>
    </div>
  </section>

  <!-- 2. Numbers -->
  <section class="section bg-dark stats-band" id="numbers">
    <div class="container">
      <dl class="big-stats">
        {SX.STATS.map((st, i) => <div><dt class="big-num" data-count={st.n} data-suffix={i === 0 ? '+' : ''} data-locale={lang}>{fmtNum(+st.n, lang)}{i === 0 ? '+' : ''}</dt><dd>{st.text}</dd></div>)}
      </dl>
    </div>
  </section>

  <!-- 3. Mission, lighting up word by word while scrolling -->
  <section class="section home-mission">
    <div class="container">
      <p class="ld-statement scrub" set:html={words(SX.MISSION)} />
      <a class="link-arrow" href={url(SX.WOA.mission.href)}>{SX.WOA.mission.title}<svg class="icon"><use href="#i-arrow" /></svg></a>
    </div>
  </section>

  <!-- 4. Three doors -->
  <section class="section-tight home-doors-wrap">
    <div class="container">
      <ul class="home-doors">
        {doors.map(d => (
          <li><a class="door" href={url(d.href)}>
            <span class="door-photo"><img src={b(d.img)} srcset={srcset(d.img)} style={phColor(d.img)} sizes="(min-width: 1024px) 33vw, 100vw" alt="" loading="lazy" /></span>
            <span class="door-body">
              <strong class="door-title">{d.title}<svg class="icon"><use href="#i-arrow" /></svg></strong>
              <span class="door-lead">{d.lead}</span>
              <span class="door-links">{d.children.slice(0, 4).map(c => <span>{c.label}</span>)}</span>
            </span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. OLY -->
  <section class="section bg-dark ld-oly">
    <div class="container ld-oly-inner">
      <figure class="ld-oly-mark"><img src={b('{{BASE}}/backgrounds/94.webp')} alt="Be OLY" loading="lazy" /></figure>
      <div class="ld-copy">
        <h2>{OLY.title}</h2>
        <p class="ld-statement-sm scrub" set:html={words(OLY.ps[0])} />
        <p class="muted-light">{OLY.ps[1]}</p>
        <a class="btn btn-gold" href={loc('/olympians/oly/')}><svg class="icon"><use href="#i-oly" /></svg>{OLY.title}</a>
      </div>
    </div>
  </section>

  <!-- 6. Ways to take part -->
  <section class="section-tight">
    <div class="container">
      <ul class="home-actions">
        {ACTIONS.map(x => <li><a class={`act act-${x.tone}`} href={loc(x.href)}><svg class="icon act-icon"><use href={`#i-${x.icon}`} /></svg><span class="act-label">{x.label}</span><svg class="icon act-arrow"><use href="#i-arrow" /></svg></a></li>)}
      </ul>
    </div>
  </section>

  <!-- 7. News -->
  <section class="section home-news">
    <div class="container">
      <div class="section-head"><h2>{newsLabel}</h2><a class="link-arrow" href={loc('/news/')}>{tr.more}<svg class="icon"><use href="#i-arrow" /></svg></a></div>
      <a class="news-lead" href={url(lead.path)}>
        <span class="news-lead-photo">{imgOk(lead.img) && <img src={b(lead.img)} srcset={srcset(lead.img)} style={phColor(lead.img)} sizes="(min-width: 1024px) 60vw, 100vw" alt="" loading="lazy" />}</span>
        <span class="news-lead-body">
          <span class="news-date"><svg class="icon icon-sm"><use href="#i-calendar" /></svg><time datetime={lead.date}>{fmtDateL(lead.date, lang)}</time></span>
          <strong class="news-lead-title">{lead.title}</strong>
          {lead.excerpt && <span class="news-lead-text">{lead.excerpt}</span>}
          <span class="link-arrow">{tr.readMore}<svg class="icon"><use href="#i-arrow" /></svg></span>
        </span>
      </a>
      <div class="grid grid-3 news-more">{more.map(n => <StoryCard item={n} showExcerpt={false} />)}</div>
    </div>
  </section>

  <!-- 8. OLY House -->
  <section class="hero ld-band home-house">
    <div class="hero-bg"><img src={b('{{BASE}}/backgrounds/63.webp')} srcset={srcset('{{BASE}}/backgrounds/63.webp')} style={phColor('{{BASE}}/backgrounds/63.webp')} sizes="100vw" alt="" loading="lazy" /></div>
    <div class="container ld-band-inner">
      <span class="house-mark"><img src={url('/images/logo-milano-cortina-2026.svg')} alt="Milano Cortina 2026" loading="lazy" /></span>
      <h2>OLY House</h2>
      <p class="lead">{SX.OLYMPIANS.house.head}</p>
      <p>{SX.OLYMPIANS.house.text}</p>
      <a class="btn btn-gold" href={loc('/oly-house/')}><svg class="icon"><use href="#i-house" /></svg>OLY House</a>
    </div>
  </section>
</Base>

<style>
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--sp-3); margin-top: var(--sp-3); }
  .home-open-inner { display: grid; gap: var(--sp-5); justify-items: center; }
  .home-open-title { font-size: clamp(2.5rem, 1.1rem + 4.4vw, 5rem); line-height: 1.04; letter-spacing: -0.035em; max-width: 18ch; }
  .home-open-lead { max-width: 40ch; font-size: var(--fs-lead); line-height: 1.4; color: var(--c-grey-600); }
  .home-actions { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-4); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .home-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .home-actions { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .home-actions li { display: grid; }
  .act { display: grid; grid-template-rows: auto 1fr auto; gap: var(--sp-5); min-height: 240px; padding: var(--sp-6); border-radius: var(--radius-xl); transition: transform var(--t), background var(--t), color var(--t); }
  .act-icon { width: 48px; height: 48px; }
  .act-label { align-self: end; font-size: var(--fs-h3); font-weight: 600; line-height: 1.15; letter-spacing: -0.022em; }
  .act-arrow { width: 28px; height: 28px; transition: transform var(--t); }
  .act:hover { transform: translateY(-4px); }
  .act:hover .act-arrow { transform: translateX(6px); }
  .act-gold { background: var(--c-gold); color: var(--c-black); }
  .act-black { background: var(--c-black); color: var(--c-white); }
  .act-black .act-icon { color: var(--c-gold); }
  .act-ink { background: var(--c-ink); color: var(--c-white); }
  .act-ink .act-icon { color: var(--c-gold); }
  .act-light { background: var(--c-grey-50); color: var(--c-ink); }
  .act-gold:hover { background: var(--c-black); color: var(--c-gold); }
  .act-black:hover, .act-ink:hover { background: var(--c-gold); color: var(--c-black); }
  .act-black:hover .act-icon, .act-ink:hover .act-icon { color: var(--c-black); }
  .act-light:hover { background: var(--c-black); color: var(--c-white); }
  @media (max-width: 639px) { .act { min-height: 0; grid-template-rows: none; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--sp-4); padding: var(--sp-5); } .act-icon { width: 36px; height: 36px; } .act-label { align-self: center; font-size: var(--fs-h4); } }
  .home-scroll { position: absolute; left: 50%; bottom: 20px; translate: -50% 0; display: grid; place-items: center; width: 48px; height: 48px; border: 1px solid rgba(255, 255, 255, .5); border-radius: 50%; color: var(--c-white); transition: background var(--t), color var(--t); }
  .home-scroll:hover { background: var(--c-white); color: var(--c-black); }
  .stats-band { padding-block: clamp(96px, 60px + 8vw, 200px); }
  .big-stats { display: grid; gap: var(--sp-8); grid-template-columns: minmax(0, 1fr); margin: 0; text-align: center; }
  @media (min-width: 834px) { .big-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } .big-stats > div + div { border-left: 1px solid #3a3a3a; } }
  .big-stats > div { display: grid; gap: var(--sp-4); justify-items: center; padding-inline: var(--sp-5); }
  .big-stats .big-num { font-size: clamp(3.5rem, 1rem + 6vw, 7.5rem); font-weight: 600; letter-spacing: -0.04em; color: var(--c-gold); }
  .big-stats dd { margin: 0; max-width: 26ch; font-size: var(--fs-lead); line-height: 1.4; color: #a1a1a6; }
  .home-mission .container { display: grid; gap: var(--sp-6); justify-items: center; text-align: center; }
  .home-mission .ld-statement { max-width: 22ch; font-weight: 600; }
  .home-doors { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-3); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1024px) { .home-doors { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .door { position: relative; display: flex; flex-direction: column; height: 100%; border-radius: var(--radius-xl); overflow: hidden; background: var(--c-grey-50); color: var(--c-ink); text-align: center; isolation: isolate; transition: background var(--t); }
  .home-doors li { display: grid; }
  .door-photo { order: 2; margin-top: auto; aspect-ratio: 4 / 3; overflow: hidden; }
  .door-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s cubic-bezier(.2, .7, .2, 1); }
  .door:hover .door-photo img { transform: scale(1.06); }
  .door:hover { background: var(--c-grey-200); }
  .door-body { order: 1; display: grid; gap: var(--sp-4); justify-items: center; padding: clamp(32px, 3vw + 8px, 48px) clamp(24px, 3vw, 40px) var(--sp-6); }
  .door-title { display: inline-flex; align-items: center; gap: 12px; font-size: clamp(2rem, 1rem + 2.4vw, 3rem); font-weight: 600; line-height: 1; letter-spacing: -0.03em; }
  .door-title .icon { width: 32px; height: 32px; transition: transform var(--t); }
  .door:hover .door-title .icon { transform: translateX(6px); }
  .door-lead { max-width: 36ch; font-size: var(--fs-body); line-height: 1.47; color: var(--c-grey-600); }
  .door-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .door-links span { padding: 6px 12px; border: 1px solid var(--c-grey-300); border-radius: 999px; font-size: var(--fs-xs); font-weight: 500; }
  .news-lead { display: grid; gap: var(--sp-5); grid-template-columns: minmax(0, 1fr); align-items: center; margin-bottom: var(--sp-7); }
  @media (min-width: 1024px) { .news-lead { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--sp-8); } }
  .news-lead-photo { display: block; aspect-ratio: 16 / 10; border-radius: var(--radius-xl); overflow: hidden; background: var(--c-grey-50); }
  .news-lead-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s cubic-bezier(.2, .7, .2, 1); }
  .news-lead:hover .news-lead-photo img { transform: scale(1.04); }
  .news-lead-body { display: grid; gap: var(--sp-4); justify-items: start; }
  .news-date { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: var(--fs-small); color: var(--c-grey-600); }
  .news-lead-title { font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.03em; transition: color var(--t); }
  .news-lead:hover .news-lead-title { color: var(--c-grey-600); }
  .news-lead:hover .link-arrow { gap: 12px; }
  .news-lead-text { color: var(--c-grey-700); font-size: var(--fs-lead); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  @media (min-width: 834px) { .news-more { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .house-mark { display: inline-block; }
  .house-mark img { display: block; width: 220px; height: auto; }
</style>
