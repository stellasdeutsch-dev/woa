---
// NOAs section landing. Sentences come from About, NOA Guide, Grants; flags from the NOA Directory.
import Base from '../../layouts/Base.astro';
import SectionHero from '../../components/landing/SectionHero.astro';
import StoryCard from '../../components/StoryCard.astro';
import { sectionOf, NOAS_LANDING as L } from '../../lib/sections';
import { url, b, srcset, words } from '../../lib/site';
const s = sectionOf('noas');
const GUIDE_ICON: Record<string, string> = { 'Member Engagement': 'friendship', 'Branding & Marketing': 'design', 'Project Delivery': 'target', 'Leadership & Governance': 'leadership', 'Finance Management': 'grant', 'Stakeholder Engagement': 'alliance', 'Best Practices': 'practice' };
---
<Base title={s.title} image={b(s.img)} description={s.lead}>
  <SectionHero s={s} />

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{L.directory.title}</h2><a class="link-arrow" href={url(L.directory.href)}>{L.directory.title}<svg class="icon"><use href="#i-arrow" /></svg></a></div>
      <ul class="ld-flags">
        {L.directory.flags.map(f => <li><a href={url(`${L.directory.href}#noa-${f.code}`)} title={f.country}><img src={b(f.flag)} alt={f.country} loading="lazy" width="48" height="36" /></a></li>)}
      </ul>
    </div>
  </section>

  <section class="section bg-grey">
    <div class="container ld-row">
      <figure class="ld-media"><img src={b(L.guide.img)} srcset={srcset(L.guide.img)} sizes="(min-width: 1024px) 55vw, 100vw" alt="" loading="lazy" /></figure>
      <div class="ld-copy">
        <h2>{L.guide.title}</h2>
        <p class="lead">{L.guide.text}</p>
        <a class="btn" href={url(L.guide.href)}>{L.guide.title}<svg class="icon icon-arrow"><use href="#i-arrow" /></svg></a>
      </div>
    </div>
    <div class="container">
      <ol class="ld-chapters">
        {L.guide.chapters.map((c, i) => <li><a href={url(c.href)}><span class="vb-num">{i + 1}</span><svg class="icon"><use href={`#i-${GUIDE_ICON[c.label] ?? 'guide'}`} /></svg><span>{c.label}</span></a></li>)}
      </ol>
    </div>
  </section>

  <section class="section bg-dark">
    <div class="container ld-grants">
      <div class="ld-copy">
        <h2>{L.grants.title}</h2>
        <p class="ld-statement-sm scrub" set:html={words(L.grants.text)} />
        <a class="btn btn-gold" href={url(L.grants.href)}><svg class="icon"><use href="#i-grant" /></svg>{L.grants.title}</a>
      </div>
      <ul class="ld-grant-list">
        {L.grants.items.map(g => { const m = g.match(/^(.*?)\s*[–-]\s*(.*)$/); return <li>{m ? <><strong>{m[2]}</strong><span>{m[1]}</span></> : <span>{g}</span>}</li>; })}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{L.practices.title}</h2><a class="link-arrow" href={url(L.practices.href)}>{L.practices.title}<svg class="icon"><use href="#i-arrow" /></svg></a></div>
      <div class="grid grid-3">{L.practices.items.map(n => <StoryCard item={n} />)}</div>
    </div>
  </section>
</Base>
