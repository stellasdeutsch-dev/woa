---
// NOA Guide chapter as a step-by-step guide: four factors as numbered steps, templates as document cards,
// tips and examples as panels. All text is the original chapter text.
import * as cheerio from 'cheerio';
import type { AnyNode } from 'domhandler';
import Base from '../../../../layouts/Base.astro';
import PageHero from '../../../../components/PageHero.astro';
import Tabs from '../../../../components/Tabs.astro';
import { page, crumbsFor } from '../../../../lib/data';
import { b, BASE } from '../../../../lib/site';

const p = page('/noas/noa-guide/member-engagement/');
const $ = cheerio.load(b(p.body), null, false);
type Sub = { title: string; nodes: AnyNode[] };
type Sec = { title: string; lead: AnyNode[]; subs: Sub[] };
const secs: Sec[] = [];
for (const el of $.root().children().toArray()) {
  const tag = (el as any).tagName;
  if (tag === 'h3') { secs.push({ title: $(el).text().trim(), lead: [], subs: [] }); continue; }
  const s = secs.at(-1); if (!s) continue;
  if (tag === 'h4') { s.subs.push({ title: $(el).text().trim(), nodes: [] }); continue; }
  (s.subs.length ? s.subs.at(-1)!.nodes : s.lead).push(el);
}
const html = (n: AnyNode) => $.html(n);
const inner = (n: AnyNode) => $(n).html() ?? '';
const isTag = (n: AnyNode, t: string) => (n as any).tagName === t;
const [intro, ...steps] = secs;
const introPs = intro.lead.filter(n => isTag(n, 'p'));
const factors = $(intro.lead.find(n => isTag(n, 'ol'))!).find('li').toArray().map(li => $(li).text().trim());
const STEP_ICON = ['design', 'channel', 'message', 'frequency'];
const slug = (t: string) => t.replace(/^\d+\.\s*/, '').toLowerCase();
const SUB_ICON: Record<string, string> = { 'What should you use?': 'goals', 'Keep in mind': 'tip', 'Call to action': 'target', 'People respond to passion.': 'heart', 'What should you be communicating?': 'chat', 'Use incentives': 'gift', 'How should you write?': 'pen', 'Time your content': 'clock', 'Avoid sending too many messages': 'bell', 'The most popular channels used by NOAs': 'channel' };
const CHANNEL_ICON: Record<string, string> = { Email: 'email', 'Social Media': 'social', 'Magazines / newsletters': 'newsletter', Websites: 'website' };
const ext = (h: string) => (h.match(/\.([a-z0-9]+)(\?|$)/i)?.[1] || '').toUpperCase();
// template list: one card per list item; items with several files get one button per file
const templates = (ul: AnyNode) => $(ul).find('li').toArray().map(li => {
  const links = $(li).find('a').toArray().map(a => ({ href: $(a).attr('href')!, text: $(a).text().trim() }));
  return { text: $(li).text().replace(/\s+/g, ' ').trim(), links };
});
// "write like this" examples: first quotation is the good one, the rest of the paragraph is the one to avoid
const compare = (n: AnyNode) => { const h = inner(n); const m = h.match(/^(\s*<em>.*?<\/em>)(.*)$/s); return m ? { good: m[1], bad: m[2].trim() } : null; };
const plain = (n: AnyNode) => $(n).text().replace(/\s+/g, ' ').trim();
const tabs = p.tabs;
const ci = tabs.findIndex(t => t.selected);
const prev = tabs[ci - 1], next = tabs[ci + 1];
const best = steps.at(-1)!.subs.find(s => /best practice/i.test(s.title));
const updatedNode = best?.nodes.find(n => /Updated on/.test(plain(n)));
const freqWords = ['daily', 'weekly', 'monthly', 'quarterly'];
// files offered only in the original side column (e.g. CV templates in several languages)
const bodyHrefs = new Set($('a').toArray().map(a => $(a).attr('href')));
const extraDocs = p.downloads.filter(d => !bodyHrefs.has(b(d.href))).map(d => ({ text: d.label, links: [{ href: b(d.href), text: d.label }] }));
---
<Base title={p.title} origPath={p.orig} image={b(p.bg)} description={p.desc || undefined}>
  <PageHero title={p.title} crumbs={crumbsFor(p)} bg={b(p.bg)} />
  <Tabs tabs={tabs} current={BASE + p.path} />

  <section class="section">
    <div class="container">
      <div class="vb-split">
        <div class="vb-text">
          <h2 class="me-h">{intro.title}</h2>
          <p class="lead-p" set:html={inner(introPs[0])} />
          <p set:html={inner(introPs[1])} />
        </div>
        <figure class="vb-media"><img src={b('{{BASE}}/backgrounds/103.webp')} alt="" loading="lazy" /></figure>
      </div>
      <p class="lead me-four" set:html={inner(introPs[2])} />
      <ol class="me-factors">
        {factors.map((f, i) => <li><a href={`#${slug(steps[i].title)}`}><span class="vb-num">{i + 1}</span><span class="vb-ico"><svg class="icon"><use href={`#i-${STEP_ICON[i]}`} /></svg></span><span class="me-factor">{f}</span></a></li>)}
      </ol>
    </div>
  </section>

  <section class="section bg-grey">
    <div class="container">
      <ol class="vb-steps">
        {steps.map((s, i) => (
          <li class="vb-step" id={slug(s.title)}>
            <span class="vb-step-num">{i + 1}</span>
            <div>
              <div class="vb-step-head"><h2>{s.title.replace(/^\d+\.\s*/, '')}</h2></div>
              <div class="vb-text">
                {s.lead.map(n => isTag(n, 'ul')
                  ? <ul class="vb-docs cols-3 me-templates">{[...templates(n), ...extraDocs].map(t => t.links.length === 1 && t.text === t.links[0].text
                      ? <li><a class="vb-doc" href={t.links[0].href} target="_blank" rel="noopener"><span class="vb-ico"><svg class="icon"><use href="#i-doc" /></svg></span><span class="vb-doc-name">{t.text}<span class="vb-doc-type">{ext(t.links[0].href)}</span></span><svg class="icon"><use href="#i-download" /></svg></a></li>
                      : <li class="vb-doc me-multi"><span class="vb-ico"><svg class="icon"><use href="#i-doc" /></svg></span><span class="vb-doc-name">{t.text}<span class="me-files">{t.links.map(l => <a href={l.href} target="_blank" rel="noopener"><svg class="icon"><use href="#i-download" /></svg>{l.text}<span class="vb-doc-type">{ext(l.href)}</span></a>)}</span></span></li>)}</ul>
                  : /daily, weekly, monthly, quarterly/.test(plain(n))
                    ? <><p set:html={inner(n)} /><ul class="vb-scale">{freqWords.map((w, k) => <li><span class="vb-dots" aria-hidden="true">{Array.from({ length: 4 - k }, () => <i />)}</span>{w}</li>)}</ul></>
                    : <p set:html={inner(n)} />)}
              </div>
              {s.subs.length > 0 && (() => {
                const subs = s.subs.filter(x => x !== best);
                const tips = subs.filter(x => ['What should you use?', 'Keep in mind', 'Time your content', 'Avoid sending too many messages'].includes(x.title));
                const rest = subs.filter(x => !tips.includes(x));
                return <>
                  {tips.length > 0 && <div class="vb-pair me-pair">{tips.map(x => <div class="vb-tip"><span class="vb-ico"><svg class="icon"><use href={`#i-${SUB_ICON[x.title] ?? 'tip'}`} /></svg></span><div><h3>{x.title}</h3>{x.nodes.map(n => <p set:html={inner(n)} />)}</div></div>)}</div>}
                  {rest.map(x => (
                    <div class="vb-sub">
                      <div class="me-sub-head"><span class="vb-ico"><svg class="icon"><use href={`#i-${SUB_ICON[x.title] ?? 'tip'}`} /></svg></span><h3>{x.title}</h3></div>
                      {x.title === 'The most popular channels used by NOAs'
                        ? <ul class="me-channels">{$(x.nodes.find(n => isTag(n, 'ul'))!).find('li').toArray().map(li => { const t = $(li).text().trim(); return <li><span class="vb-ico"><svg class="icon"><use href={`#i-${CHANNEL_ICON[t] ?? 'website'}`} /></svg></span>{t}</li>; })}</ul>
                        : x.nodes.map(n => {
                            if (isTag(n, 'ul')) {
                              const lis = $(n).find('li').toArray();
                              const linked = lis.some(li => $(li).find('a').length);
                              return linked
                                ? <ul class="vb-docs me-links">{lis.map(li => { const a = $(li).find('a').first(); return a.length ? <li><a class="vb-doc" href={a.attr('href')} target="_blank" rel="noopener"><span class="vb-ico"><svg class="icon"><use href="#i-news" /></svg></span><span class="vb-doc-name">{$(li).text().trim()}</span><svg class="icon"><use href="#i-external" /></svg></a></li> : <li class="vb-doc me-nolink"><span class="vb-ico"><svg class="icon"><use href="#i-news" /></svg></span><span class="vb-doc-name">{$(li).text().trim()}</span></li>; })}</ul>
                                : <ul class="vb-chips">{lis.map(li => <li><span>{$(li).text().trim()}</span></li>)}</ul>;
                            }
                            const c = x.title === 'How should you write?' && /^\s*<em>/.test(inner(n)) ? compare(n) : null;
                            return c ? <div class="vb-compare"><p class="vb-do"><span class="vb-mark"><svg class="icon"><use href="#i-check" /></svg></span><span set:html={c.good} /></p><p class="vb-dont"><span class="vb-mark"><svg class="icon"><use href="#i-close" /></svg></span><span set:html={c.bad} /></p></div>
                              : x.title === 'Call to action' ? <p class="me-cta-text" set:html={inner(n)} />
                              : <p set:html={inner(n)} />;
                          })}
                    </div>
                  ))}
                </>;
              })()}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {best && (
    <section class="section-tight">
      <div class="container">
        {(() => { const n = best.nodes.find(x => x !== updatedNode)!; const a = $(n).find('a').first(); return (
          <a class="vb-cta" href={a.attr('href')}>
            <span class="vb-ico"><svg class="icon icon-lg"><use href="#i-practice" /></svg></span>
            <div><h2>{best.title.charAt(0) + best.title.slice(1).toLowerCase()}</h2><p>{plain(n)}</p></div>
            <span class="link-arrow" aria-hidden="true"><svg class="icon"><use href="#i-arrow" /></svg></span>
          </a>); })()}
        {updatedNode && <p class="vb-updated me-updated"><svg class="icon"><use href="#i-calendar" /></svg>{plain(updatedNode)}</p>}
        <nav class="vb-pager me-pager" aria-label="NOA Guide">
          {prev ? <a class="prev" href={b(prev.href)}><svg class="icon"><use href="#i-arrow-left" /></svg>{prev.label}</a> : <span />}
          {next && <a class="next" href={b(next.href)}>{next.label}<svg class="icon"><use href="#i-arrow" /></svg></a>}
        </nav>
      </div>
    </section>
  )}
</Base>

<style>
  .me-h { font-size: var(--fs-h2); line-height: 1.2; }
  .me-four { margin-top: var(--sp-8); margin-bottom: var(--sp-5); }
  .me-factors { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-4); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 1024px) { .me-factors { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .me-factors a { position: relative; display: grid; justify-items: center; gap: var(--sp-4); padding: var(--sp-7) var(--sp-4) var(--sp-6); border: 1px solid var(--c-grey-200); border-radius: var(--radius-lg); text-align: center; transition: border-color var(--t), transform var(--t); }
  .me-factors a:hover { border-color: var(--c-black); transform: translateY(-2px); }
  .me-factors .vb-num { position: absolute; top: var(--sp-4); left: var(--sp-4); width: 32px; height: 32px; font-size: .9375rem; }
  .me-factors .vb-ico { width: 72px; height: 72px; }
  .me-factors .vb-ico .icon { width: 64px; height: 64px; stroke-width: 1.2; }
  .me-factor { font-size: var(--fs-h4); font-weight: 700; }
  .me-templates { margin-top: var(--sp-5); }
  .me-multi { grid-template-columns: 48px minmax(0, 1fr); align-items: start; }
  .me-multi:hover { transform: none; border-color: var(--c-grey-200); }
  .me-files { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-2); }
  .me-files a { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 4px 12px; border: 1px solid var(--c-grey-200); border-radius: 999px; font-size: var(--fs-small); transition: border-color var(--t); }
  .me-files a:hover { border-color: var(--c-black); }
  .me-files .icon { width: 16px; height: 16px; }
  .me-pair { margin-top: var(--sp-6); }
  @media (max-width: 639px) { .me-pair :global(.vb-tip) { grid-template-columns: minmax(0, 1fr); } }
  .me-sub-head { display: flex; align-items: center; gap: var(--sp-4); }
  .me-sub-head .vb-ico { width: 48px; height: 48px; }
  .me-sub-head .vb-ico .icon { width: 40px; height: 40px; stroke-width: 1.4; }
  .me-channels { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-3); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 1024px) { .me-channels { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .me-channels li { display: grid; justify-items: center; gap: var(--sp-3); padding: var(--sp-5) var(--sp-3); background: var(--c-white); border-radius: var(--radius-lg); font-weight: 600; text-align: center; }
  .me-channels .vb-ico .icon { width: 48px; height: 48px; stroke-width: 1.3; }
  .me-cta-text { font-size: var(--fs-lead); font-weight: 600; line-height: 1.5; }
  .me-links { margin-top: var(--sp-2); }
  .me-nolink:hover { transform: none; border-color: var(--c-grey-200); }
  .me-updated { margin-top: var(--sp-6); }
  .me-pager { margin-top: var(--sp-7); }
</style>
