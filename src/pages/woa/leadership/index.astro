---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import { page, leadership } from '../../../lib/data';
import { b, prose } from '../../../lib/site';

const p = page('/woa/leadership/');
const split = (n: string) => n.replace(/\s+OLY$/, '');
const hasOly = (n: string) => /\sOLY$/.test(n);
---
<Base title={p.title} origPath={p.orig} image={b(p.bg)}>
  <PageHero title={p.title} crumbs={[{ label: 'WOA', href: '/woa/about/' }, { label: p.title }]} bg={b(p.bg)} />
  <section class="section-tight">
    <div class="container">
      <ul class="honorary">
        {leadership.honorary.map(h => <li><p class="h-name">{split(h.name)}{hasOly(h.name) && <small> OLY</small>}</p><p class="h-role">{h.role}</p></li>)}
      </ul>
    </div>
  </section>
  <section class="section bg-grey">
    <div class="container">
      <div class="section-head"><h2>Executive Committee</h2></div>
      <ul class="people">
        {leadership.people.map((x, i) => (
          <li class="person card">
            <button class="person-btn" type="button" data-person={i} aria-haspopup="dialog">
              <span class="card-media"><img src={b(x.img)} alt="" loading="lazy" /></span>
              <span class="card-body">
                <span class="card-title">{split(x.name)}{hasOly(x.name) && <small> OLY</small>}</span>
                <span class="card-meta">{x.meta}</span>
                <span class="p-role">{x.role}</span>
              </span>
            </button>
            <dialog class="person-dlg" id={`person-${i}`} aria-label={x.name}>
              <div class="pd-head">
                <img src={b(x.img)} alt="" loading="lazy" />
                <div>
                  <h3>{split(x.name)}{hasOly(x.name) && <small> OLY</small>}</h3>
                  <p class="card-meta">{x.meta}</p>
                  <p class="p-role">{x.role}</p>
                </div>
                <button class="icon-btn pd-close" type="button" data-close aria-label="Close"><svg class="icon"><use href="#i-close" /></svg></button>
              </div>
              <div class="prose pd-body" set:html={prose(x.bio, { toc: false }).html} />
            </dialog>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-person]').forEach(btn => {
    const d = document.getElementById('person-' + btn.dataset.person) as HTMLDialogElement;
    btn.addEventListener('click', () => d.showModal());
    d.querySelector('[data-close]')!.addEventListener('click', () => d.close());
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  });
</script>
<style>
  .honorary { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-4); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 1024px) { .honorary { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .honorary li { padding: var(--sp-5); background: var(--c-grey-50); border-radius: var(--radius-lg); }
  .h-role { font-size: var(--fs-small); color: var(--c-grey-700); font-weight: 600; }
  .h-role { margin-top: var(--sp-2); } .h-name { font-size: var(--fs-h4); font-weight: 700; line-height: 1.3; }
  small { font-size: .7em; font-weight: 700; color: var(--c-grey-600); }
  .people { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-5); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 834px) { .people { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .people { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .person-btn { all: unset; display: flex; flex-direction: column; height: 100%; cursor: pointer; }
  .person-btn:focus-visible { outline: 2px solid var(--c-gold); outline-offset: 2px; }
  .person .card-media { aspect-ratio: 4 / 5; display: block; }
  .person .card-body { gap: 6px; padding: var(--sp-4); }
  .person .card-title { font-size: 1.0625rem; }
  .p-role { font-size: var(--fs-xs); font-weight: 600; color: var(--c-grey-700); }
  .person-dlg { width: min(820px, calc(100% - 24px)); max-height: 88vh; padding: 0; border: 0; border-radius: var(--radius-lg); box-shadow: 0 24px 64px rgba(0, 0, 0, .3); }
  .person-dlg::backdrop { background: rgba(0, 0, 0, .55); }
  .pd-head { position: sticky; top: 0; display: grid; grid-template-columns: 96px minmax(0, 1fr) auto; gap: var(--sp-5); align-items: center; padding: var(--sp-5); background: var(--c-white); border-bottom: 1px solid var(--c-grey-200); }
  .pd-head img { width: 96px; height: 96px; object-fit: cover; border-radius: 50%; }
  .pd-head h3 { font-size: var(--fs-h3); }
  .pd-close { align-self: start; }
  .pd-body { padding: var(--sp-6); }
  @media (max-width: 520px) { .pd-head { grid-template-columns: 64px minmax(0, 1fr) auto; gap: var(--sp-3); } .pd-head img { width: 64px; height: 64px; } }
</style>
