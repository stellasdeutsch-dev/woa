---
import Base from '../../../layouts/Base.astro';
import StoryList from '../../../components/templates/StoryList.astro';
import { news } from '../../../lib/data';
import { b } from '../../../lib/site';
export function getStaticPaths() {
  return [...new Set(news.map(s => s.date!.slice(0, 4)))].map(y => ({ params: { y } }));
}
const y = Astro.params.y!;
const items = news.filter(s => s.date!.startsWith(y));
---
<Base title={`News ${y}`} type="Page" search={false}>
  <StoryList title="News" base="/news/" all={news} items={items} year={y} bg={b(items[0].img)} />
</Base>
