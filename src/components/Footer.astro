---
import { navFor, SOCIAL, EMAIL, url, LOGO } from '../lib/site';
import { langOf, L, t } from '../lib/i18n';
const lang = langOf(Astro.url.pathname); const tr = t(lang);
const NAV = navFor(lang);
const groups = NAV.filter(n => n.children);
const singles = NAV.filter(n => !n.children);
---
<footer class="site-footer">
  <div class="container">
    <div class="f-top">
      <div class="f-brand">
        <a class="f-logo" href={url(L('/', lang))} aria-label={`${tr.org} — ${tr.home}`}>
          <img src={LOGO} alt="World Olympians Association" width="124" height="144" loading="lazy" />
        </a>
        <a class="f-mail" href={`mailto:${EMAIL}`}><svg class="icon"><use href="#i-mail" /></svg>{EMAIL}</a>
        <ul class="f-social">
          {SOCIAL.map(s => <li><a class="icon-btn" href={s.href} target="_blank" rel="noopener" aria-label={s.label}><svg class="icon"><use href={`#i-${s.icon}`} /></svg></a></li>)}
        </ul>
      </div>
      <nav class="f-nav" aria-label={tr.footer}>
        {groups.map(g => (
          <div>
            <h2><a href={url(g.href)}>{g.label}</a></h2>
            <ul>{g.children!.map(c => <li><a href={url(c.href)}>{c.label}</a></li>)}</ul>
          </div>
        ))}
        <div>
          <h2 class="sr-only">{tr.more}</h2>
          <ul class="f-singles">{singles.map(s => <li><a href={url(s.href)}>{s.label}</a></li>)}</ul>
        </div>
      </nav>
    </div>
    <div class="f-bottom">
      <p>{tr.copyright}</p>
      <a href={url(L('/privacy-policy/', lang))}>{tr.privacy}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--c-grey-50); color: var(--c-grey-600); padding-block: var(--sp-8) var(--sp-6); font-size: .8125rem; }
  .f-top { display: grid; gap: var(--sp-8); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1024px) { .f-top { grid-template-columns: 280px minmax(0, 1fr); } }
  .f-brand { display: grid; gap: var(--sp-5); justify-items: start; align-content: start; }
  .f-logo { display: block; transition: transform var(--t), opacity var(--t); }
  .f-logo:hover { opacity: .7; }
  .f-logo img { height: 72px; width: auto; }
  .f-mail { display: inline-flex; align-items: center; gap: 10px; font-weight: 500; color: var(--c-ink); transition: color var(--t); }
  .f-mail:hover { color: var(--c-gold-ink); }
  .f-social { display: flex; gap: var(--sp-2); list-style: none; margin: 0; padding: 0; }
  .f-social .icon-btn { border: 1px solid var(--c-grey-300); color: var(--c-ink); }
  .f-social .icon-btn:hover { background: var(--c-ink); border-color: var(--c-ink); color: var(--c-white); }
  .f-nav { display: grid; gap: var(--sp-7) var(--sp-6); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 834px) { .f-nav { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .f-nav h2 { font-size: .8125rem; font-weight: 600; letter-spacing: -0.01em; color: var(--c-ink); margin-bottom: var(--sp-3); }
  .f-nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-2); }
  .f-nav a { color: var(--c-grey-600); font-size: .8125rem; transition: color var(--t); }
  .f-nav h2 a { color: var(--c-ink); font-size: .8125rem; transition: color var(--t); }
  .f-nav h2 a:hover { color: var(--c-gold-ink); }
  .f-nav a:hover { color: var(--c-ink); }
  .f-singles a { color: var(--c-ink) !important; font-weight: 600; font-size: .8125rem !important; }
  .f-singles a:hover { color: var(--c-gold-ink) !important; }
  .f-bottom { margin-top: var(--sp-7); padding-top: var(--sp-5); border-top: 1px solid var(--c-grey-300); display: flex; flex-wrap: wrap; gap: var(--sp-3) var(--sp-6); justify-content: space-between; font-size: .75rem; color: var(--c-grey-600); }
  .f-bottom a { transition: color var(--t); }
  .f-bottom a:hover { color: var(--c-ink); }
  @media (max-width: 639px) { .f-nav ul { gap: 0; } .f-nav a, .f-bottom a, .f-mail { display: inline-flex; align-items: center; min-height: 44px; } }
</style>
