---
import { navFor, url, LOGO, b, srcset, phColor } from '../lib/site';
import { sections } from '../lib/sections';
import { altPath } from '../lib/data';
import { langOf, L, t, LANGS, LANG_NAME } from '../lib/i18n';
const { current = '' } = Astro.props as { current?: string };
const lang = langOf(Astro.url.pathname); const tr = t(lang);
const NAV = navFor(lang);
const SECTIONS = sections(lang).SECTIONS;
const sec = (href: string) => SECTIONS.find(x => x.href === href);
// the same page in the other languages
const alts = LANGS.map(l => ({ l, name: LANG_NAME[l], href: url(altPath(current, lang, l)) }));
const isCur = (href: string, children?: { href: string }[]) => {
  const top = href.split('/')[1];
  if (children) return current.startsWith(href) || children.some(c => current.startsWith(c.href));
  return current.startsWith(href);
};
---
<header class="site-header" id="top">
  <div class="container header-row">
    <a class="logo" href={url(L('/', lang))} aria-label={`${tr.org} — ${tr.home}`}>
      <img src={LOGO} alt={tr.org} width="124" height="144" />
    </a>
    <nav class="main-nav" aria-label={tr.main}>
      <ul>
        {NAV.map(item => (
          <li class={item.children ? 'has-sub' : ''}>
            <a href={url(item.href)} aria-current={isCur(item.href, item.children) ? 'page' : undefined}>
              {item.label}{item.children && <svg class="icon icon-sm"><use href="#i-chevron" /></svg>}
            </a>
            {item.children && (
              <div class="mega">
                <div class="container mega-inner">
                  {sec(item.href) && (
                    <a class="mega-feature" href={url(item.href)}>
                      <span class="mega-photo"><img src={b(sec(item.href)!.img)} srcset={srcset(sec(item.href)!.img)} style={phColor(sec(item.href)!.img)} sizes="360px" alt="" loading="lazy" /></span>
                      <span class="mega-title">{item.label}<svg class="icon"><use href="#i-arrow" /></svg></span>
                      <span class="mega-lead">{sec(item.href)!.lead}</span>
                    </a>
                  )}
                  <ul class="mega-list">
                    {item.children!.map(c => (
                      <li><a href={url(c.href)} aria-current={current.startsWith(c.href) ? 'page' : undefined}><svg class="icon"><use href={`#i-${c.icon}`} /></svg><span>{c.label}</span></a></li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      {alts.length > 1 && <div class="lang-switch">
        <button class="lang-btn" type="button" aria-label={tr.language} aria-haspopup="true"><svg class="icon"><use href="#i-globe" /></svg><span>{lang.toUpperCase()}</span></button>
        <ul class="lang-menu">
          {alts.map(a => <li><a href={a.href} hreflang={a.l} lang={a.l} aria-current={a.l === lang ? 'true' : undefined}>{a.name}</a></li>)}
        </ul>
      </div>}
      <button class="icon-btn" type="button" data-open-search aria-label={tr.search}><svg class="icon"><use href="#i-search" /></svg></button>
      <a class="btn btn-sm header-cta" href={url(L('/olympians/oly/', lang))}><svg class="icon"><use href="#i-oly" /></svg>{tr.registerOly}</a>
      <button class="icon-btn menu-btn" type="button" data-open-menu aria-label={tr.menu} aria-expanded="false" aria-controls="mobile-menu"><svg class="icon"><use href="#i-menu" /></svg></button>
    </div>
  </div>
</header>

<dialog class="mobile-menu" id="mobile-menu" aria-label={tr.menu}>
  <div class="mm-head">
    <a class="logo" href={url(L('/', lang))} aria-label={`${tr.org} — ${tr.home}`}><img src={LOGO} alt={tr.org} width="124" height="144" /></a>
    <button class="icon-btn" type="button" data-close-menu aria-label={tr.close}><svg class="icon"><use href="#i-close" /></svg></button>
  </div>
  <nav aria-label={tr.main}>
    <ul class="mm-list">
      {NAV.map(item => item.children ? (
        <li>
          <details open={isCur(item.href, item.children)}>
            <summary>{item.label}<svg class="icon"><use href="#i-chevron" /></svg></summary>
            <ul>
              <li><a class="mm-landing" href={url(item.href)} aria-current={current === item.href ? 'page' : undefined}><svg class="icon"><use href="#i-arrow" /></svg>{item.label}</a></li>
              {item.children.map(c => <li><a href={url(c.href)} aria-current={current.startsWith(c.href) ? 'page' : undefined}><svg class="icon"><use href={`#i-${c.icon}`} /></svg>{c.label}</a></li>)}
            </ul>
          </details>
        </li>
      ) : (
        <li><a class="mm-top" href={url(item.href)} aria-current={isCur(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
  <div class="mm-foot">
    <a class="btn" href={url(L('/olympians/oly/', lang))}><svg class="icon"><use href="#i-oly" /></svg>{tr.registerOly}</a>
    <a class="btn btn-outline" href={url(L('/noas/noa-directory/', lang))}><svg class="icon"><use href="#i-directory" /></svg>{NAV[2].children![1].label}</a>
    {alts.length > 1 && <ul class="mm-langs">{alts.map(a => <li><a href={a.href} hreflang={a.l} lang={a.l} aria-current={a.l === lang ? 'true' : undefined}>{a.name}</a></li>)}</ul>}
  </div>
</dialog>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: #fbfbfd; border-bottom: 1px solid var(--c-grey-200); }
  .header-row { display: flex; align-items: center; gap: var(--sp-5); height: var(--header-h); }
  .logo { flex: none; display: block; transition: opacity var(--t); }
  .logo:hover { opacity: .75; }
  .logo img { height: 46px; width: auto; }
  .main-nav { flex: 1; display: none; }
  .main-nav > ul { display: flex; justify-content: center; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .main-nav > ul > li { display: flex; align-items: center; height: var(--header-h); }
  .main-nav > ul > li > a { display: inline-flex; align-items: center; gap: 4px; height: 36px; padding: 0 14px; border-radius: 980px; font-weight: 500; font-size: .875rem; color: var(--c-ink); white-space: nowrap; transition: background var(--t), color var(--t); }
  .main-nav > ul > li > a .icon { width: 16px; height: 16px; transition: transform var(--t); }
  .main-nav > ul > li > a:hover, .main-nav li.has-sub:hover > a, .main-nav li.has-sub:focus-within > a { background: var(--c-grey-200); }
  .main-nav > ul > li > a[aria-current="page"] { box-shadow: inset 0 -2px 0 var(--c-gold); border-radius: 0; }
  .main-nav li.has-sub:hover > a .icon, .main-nav li.has-sub:focus-within > a .icon { transform: rotate(180deg); }
  .mega { position: absolute; left: 0; right: 0; top: 100%; background: #fbfbfd; border-top: 1px solid var(--c-grey-200); border-bottom: 1px solid var(--c-grey-200); box-shadow: 0 24px 40px rgba(0, 0, 0, .08); opacity: 0; visibility: hidden; transform: translateY(-6px); transition: opacity var(--t), transform var(--t), visibility var(--t); }
  .has-sub:hover .mega, .has-sub:focus-within .mega { opacity: 1; visibility: visible; transform: none; }
  .mega-inner { display: grid; grid-template-columns: 420px minmax(0, 1fr); gap: var(--sp-8); padding-block: var(--sp-6) var(--sp-7); }
  .mega-feature { display: grid; grid-template-columns: 140px minmax(0, 1fr); grid-template-rows: auto 1fr; gap: 6px var(--sp-4); align-items: start; padding: var(--sp-3); margin: calc(var(--sp-3) * -1); border-radius: var(--radius-lg); transition: background var(--t); }
  .mega-feature:hover { background: var(--c-grey-50); }
  .mega-photo { grid-row: span 2; aspect-ratio: 1; border-radius: var(--radius); overflow: hidden; }
  .mega-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease, ease); }
  .mega-feature:hover .mega-photo img { transform: scale(1.06); }
  .mega-title { display: inline-flex; align-items: center; gap: 10px; font-size: 1.75rem; font-weight: 600; letter-spacing: -0.022em; line-height: 1.1; }
  .mega-title .icon { transition: transform var(--t); }
  .mega-feature:hover .mega-title .icon { transform: translateX(4px); }
  .mega-lead { font-size: var(--fs-small); line-height: 1.5; color: var(--c-grey-700); }
  .mega-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px var(--sp-5); align-content: start; }
  .mega-list a { display: flex; align-items: center; gap: 14px; min-height: 56px; padding: 8px 14px; border-radius: var(--radius); font-weight: 500; transition: background var(--t); }
  .mega-list a .icon { width: 30px; height: 30px; flex: none; }
  .mega-list a:hover, .mega-list a[aria-current="page"] { background: var(--c-grey-200); }
  .lang-switch { position: relative; }
  .lang-btn { display: inline-flex; align-items: center; gap: 6px; height: 44px; padding: 0 10px; border: 0; border-radius: var(--radius); background: transparent; font: inherit; font-weight: 700; font-size: var(--fs-small); color: inherit; cursor: pointer; transition: background var(--t); }
  .lang-btn:hover, .lang-switch:focus-within .lang-btn { background: var(--c-grey-200); }
  .lang-menu { position: absolute; right: 0; top: 100%; min-width: 160px; margin: 0; padding: 6px; list-style: none; background: var(--c-white); border: 1px solid var(--c-grey-200); border-radius: var(--radius-lg); box-shadow: var(--shadow); opacity: 0; visibility: hidden; transform: translateY(4px); transition: opacity var(--t), transform var(--t), visibility var(--t); z-index: 5; }
  .lang-switch:hover .lang-menu, .lang-switch:focus-within .lang-menu { opacity: 1; visibility: visible; transform: none; }
  .lang-menu a { display: flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: var(--radius); font-weight: 600; font-size: var(--fs-small); transition: background var(--t); }
  .lang-menu a:hover { background: var(--c-grey-50); }
  .lang-menu a[aria-current] { font-weight: 800; }
  .lang-menu a[aria-current]::after { content: ''; width: 6px; height: 6px; margin-left: auto; border-radius: 50%; background: var(--c-gold); }
  @media (max-width: 1199px) { .lang-switch { display: none; } }
  .mm-langs { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--sp-2); }
  .mm-langs a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; border: 1px solid var(--c-grey-200); border-radius: 999px; font-weight: 600; font-size: var(--fs-small); transition: border-color var(--t); }
  .mm-langs a:hover { border-color: var(--c-black); }
  .mm-langs a[aria-current] { border-color: var(--c-black); font-weight: 800; }
  .header-actions { margin-left: auto; display: flex; align-items: center; gap: var(--sp-2); }
  .header-cta { display: none; }
  @media (min-width: 640px) { .header-cta { display: inline-flex; } }
  @media (min-width: 1200px) { .main-nav { display: block; } .menu-btn { display: none; } .header-actions { margin-left: 0; } .logo img { height: 48px; } }
  @media (max-width: 1199px) { :global(:root) { --header-h: 60px; } }

  .mobile-menu { margin: 0; width: 100%; max-width: 100%; height: 100%; max-height: 100%; padding: 0; border: 0; background: var(--c-white); color: var(--c-ink); overflow-y: auto; }
  .mobile-menu[open] { display: flex; flex-direction: column; }
  .mobile-menu::backdrop { background: rgba(0, 0, 0, .4); }
  .mm-head { flex: none; display: flex; align-items: center; justify-content: space-between; height: var(--header-h); padding-inline: var(--gutter); border-bottom: 1px solid var(--c-grey-200); }
  .mm-head .logo img { height: 44px; }
  .mm-list { flex: none; list-style: none; margin: 0; padding: var(--sp-3) var(--gutter); }
  .mm-list > li { border-bottom: 1px solid var(--c-grey-200); }
  .mm-list summary, .mm-top { display: flex; align-items: center; justify-content: space-between; min-height: 60px; font-size: 1.75rem; font-weight: 600; letter-spacing: -0.022em; cursor: pointer; list-style: none; transition: color var(--t); }
  .mm-list summary::-webkit-details-marker { display: none; }
  .mm-list summary:hover, .mm-top:hover { color: var(--c-grey-600); }
  .mm-list summary .icon { transition: transform var(--t); }
  .mm-list details[open] summary .icon { transform: rotate(180deg); }
  .mm-list details ul { list-style: none; margin: 0 0 var(--sp-4); padding: 0; display: grid; gap: 2px; }
  .mm-list details a { display: flex; align-items: center; gap: 12px; padding: 12px; border-radius: var(--radius); font-weight: 600; transition: background var(--t); }
  .mm-landing { font-weight: 700 !important; }
  .mm-list details a:hover, .mm-list a[aria-current="page"] { background: var(--c-grey-50); }
  .mm-foot { margin-top: auto; padding: var(--sp-5) var(--gutter) var(--sp-7); display: grid; gap: var(--sp-3); }
</style>
