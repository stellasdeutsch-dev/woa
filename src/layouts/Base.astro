---
import '@fontsource-variable/montserrat/wght.css';
import '@fontsource-variable/montserrat/wght-italic.css';
import fontLatin from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import '../styles/global.css';
import IconSprite from '../components/IconSprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url, BASE, ORIGIN } from '../lib/site';
import { altPath } from '../lib/data';
import { langOf, t, LANGS, stripLang } from '../lib/i18n';

interface Props { title: string; description?: string; current?: string; image?: string | null; origPath?: string; type?: string; noindex?: boolean; search?: boolean }
const { title, description = 'The member organisation of Olympians - for Olympians. Bringing Olympic values to life.', current = Astro.url.pathname.replace(BASE, ''), image, origPath, type = 'Page', noindex = false, search = true } = Astro.props;
const lang = langOf(Astro.url.pathname); const tr = t(lang);
const fullTitle = title === 'World Olympians Association' || title === tr.org ? title : `${title} | ${tr.org}`;
const alternates = LANGS.map(l => ({ l, href: new URL(url(altPath(current, lang, l)), Astro.site).href }));
const ogImage = image ? new URL(image, Astro.site).href : new URL(url('/images/og-image-logo.jpg'), Astro.site).href;
const original = ORIGIN + (origPath ?? stripLang(current));
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
  <script is:inline>
    // Slow connection or data saver: "lite" mode — smaller photos, no motion (see global.css and the script at the end of <body>)
    (function () { try { var c = navigator.connection || {}; if (c.saveData || /2g|3g/.test(c.effectiveType || '') || matchMedia('(prefers-reduced-data: reduce)').matches) { document.documentElement.classList.add('lite');
      new MutationObserver(function (ms) { ms.forEach(function (m) { m.addedNodes.forEach(function (n) { if (n.tagName === 'IMG' && n.srcset) n.sizes = '480px'; }); }); }).observe(document.documentElement, { childList: true, subtree: true }); } } catch (e) {} })();
  </script>
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#ffffff" />
  {noindex && <meta name="robots" content="noindex" />}
  {alternates.length > 1 && alternates.map(a => <link rel="alternate" hreflang={a.l} href={a.href} />)}
  <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32x32.png')} />
  <link rel="icon" type="image/png" sizes="16x16" href={url('/favicon-16x16.png')} />
  <link rel="apple-touch-icon" sizes="180x180" href={url('/apple-touch-icon.png')} />
</head>
<body data-base={BASE} data-original={original} data-no-results={tr.noResults}>
  <IconSprite />
  <a class="skip" href="#main">{tr.skip}</a>
  <Header current={current} />
  <main id="main" data-pagefind-body={search ? '' : undefined} data-pagefind-meta={search ? `type:${type}` : undefined}>
    <slot />
  </main>
  <Footer />
  <div class="scrollbar" aria-hidden="true"><div class="sb-fill"></div><div class="sb-dots"></div><div class="sb-thumb"><svg class="sb-ring" viewBox="0 0 56 56"><circle cx="28" cy="28" r="26" /></svg><span class="sb-oly">OLY</span><span class="sb-pct"></span></div></div>

  <dialog class="search-dialog" id="search" aria-label={tr.search}>
    <div class="sd-box">
      <form class="sd-form" role="search" onsubmit="return false">
        <svg class="icon"><use href="#i-search" /></svg>
        <label class="sr-only" for="sd-q">{tr.search}</label>
        <input id="sd-q" type="search" placeholder={tr.search} autocomplete="off" spellcheck="false" />
        <button class="icon-btn" type="button" data-close-search aria-label={tr.close}><svg class="icon"><use href="#i-close" /></svg></button>
      </form>
      <div class="sd-results" aria-live="polite"></div>
    </div>
  </dialog>

  <script>
    // Photos fade in once loaded (their dominant colour shows meanwhile); in lite mode the 480px copy is used
    const lite = document.documentElement.classList.contains('lite');
    for (const img of document.querySelectorAll<HTMLImageElement>('img')) {
      if (lite && img.srcset) img.sizes = '480px';
      if (img.complete || navigator.webdriver || lite) continue;
      img.classList.add('lz-wait');
      const done = () => { img.classList.add('lz-in'); img.classList.remove('lz-wait'); };
      img.addEventListener('load', done, { once: true }); img.addEventListener('error', done, { once: true });
    }
  </script>
  <script>
    // Motion: reveal blocks below the fold and count up big numbers. Skipped for reduced motion and automated browsers (Figma export, tests).
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches || navigator.webdriver || document.documentElement.classList.contains('lite');
    if (navigator.webdriver) document.documentElement.classList.add('still');
    if (!still && 'IntersectionObserver' in window) {
      const SEL = '.section-head, .grid > *, .vb-cards > li, .vb-index > li, .vb-step, .vb-panels > .vb-panel, .vb-docs > li, .big-stats > div, .noa-group, .steps > li, .goals > li, .values > li, .mv-card, .vb-quote, .vb-split > *, .vb-years > li, .me-factors > li, .vb-list > li, .vb-faq, .vb-answer, .house-banner, .oly-feature > *';
      const els = [...document.querySelectorAll<HTMLElement>(SEL)].filter(el => el.getBoundingClientRect().top > innerHeight * 0.9);
      const io = new IntersectionObserver(entries => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          el.classList.add('rv-in');
          el.addEventListener('transitionend', () => { el.classList.remove('rv', 'rv-in'); el.style.transitionDelay = ''; }, { once: true });
          io.unobserve(el);
        }
      }, { rootMargin: '0px 0px -8% 0px' });
      for (const el of els) {
        const i = el.parentElement ? [...el.parentElement.children].indexOf(el) : 0;
        el.style.transitionDelay = `${(i % 6) * 60}ms`;
        el.classList.add('rv'); io.observe(el);
      }
      // numbers grow to their final value (the final value is already in the HTML)
      const nums = document.querySelectorAll<HTMLElement>('[data-count]');
      const co = new IntersectionObserver(entries => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement; co.unobserve(el);
          const end = +el.dataset.count!; const suffix = el.dataset.suffix || ''; const t0 = performance.now(); const D = 1200;
          const step = (t: number) => { const k = Math.min(1, (t - t0) / D); const v = Math.round(end * (1 - Math.pow(1 - k, 3))); el.textContent = v.toLocaleString({ fr: 'fr-FR', es: 'es-ES' }[el.dataset.locale || ''] || 'en-GB') + suffix; if (k < 1) requestAnimationFrame(step); };
          requestAnimationFrame(step);
        }
      }, { threshold: 0.6 });
      nums.forEach(n => co.observe(n));
    }
  </script>
  <script>
    import { swipeToClose } from '../lib/swipe';
    const body = document.body;
    const BASE = body.dataset.base || '';
    document.documentElement.classList.add('js');
    // long text: "Read More" opens the rest of the paragraphs (hidden="until-found" keeps it findable with Ctrl+F)
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    const setMore = (btn: HTMLElement, open: boolean, animate = true) => {
      const box = document.getElementById(btn.getAttribute('aria-controls') || '');
      if (!box) return;
      btn.setAttribute('aria-expanded', String(open));
      (btn.querySelector('span') as HTMLElement).textContent = open ? btn.dataset.less! : btn.dataset.more!;
      const run = (from: string, to: string, done?: () => void) => {
        if (!animate || calm.matches) { done?.(); return; }
        box.animate([{ height: from, opacity: from === '0px' ? 0 : 1 }, { height: to, opacity: to === '0px' ? 0 : 1 }], { duration: 320, easing: 'cubic-bezier(.2,.7,.2,1)' }).finished.then(() => done?.(), () => done?.());
      };
      if (open) { box.hidden = false; run('0px', `${box.scrollHeight}px`); }
      else {
        run(`${box.scrollHeight}px`, '0px', () => box.setAttribute('hidden', 'until-found'));
        const top = btn.closest('.vb-more')!.getBoundingClientRect().top;
        if (top < 0) btn.closest('.vb-more')!.previousElementSibling?.scrollIntoView({ block: 'start', behavior: calm.matches ? 'auto' : 'smooth' });
      }
    };
    document.addEventListener('click', (e) => { const btn = (e.target as HTMLElement).closest('.vb-more-btn') as HTMLElement | null; if (btn) setMore(btn, btn.getAttribute('aria-expanded') !== 'true'); });
    document.addEventListener('beforematch', (e) => { const box = e.target as HTMLElement; if (!box.classList?.contains('vb-more-body')) return; const btn = document.querySelector(`[aria-controls="${box.id}"]`) as HTMLElement | null; if (btn) setMore(btn, true, false); }, true);
    // tabsets
    document.querySelectorAll('.tabset').forEach((set) => {
      const btns = [...set.querySelectorAll<HTMLButtonElement>('.tabset-nav button')];
      const nav = set.querySelector('.tabset-nav'); nav?.setAttribute('role', 'tablist');
      const show = (id: string) => btns.forEach((b) => { const on = b.dataset.tab === id; b.setAttribute('aria-selected', String(on)); const p = set.querySelector<HTMLElement>('#' + CSS.escape(b.dataset.tab!)); if (p) p.hidden = !on; });
      btns.forEach((b) => { b.setAttribute('role', 'tab'); b.addEventListener('click', () => show(b.dataset.tab!)); });
      if (btns[0]) show(btns[0].dataset.tab!);
    });
    // Mobile menu
    const menu = document.getElementById('mobile-menu') as HTMLDialogElement | null;
    const menuBtn = document.querySelector('[data-open-menu]');
    menuBtn?.addEventListener('click', () => { menu?.showModal(); menuBtn.setAttribute('aria-expanded', 'true'); });
    document.querySelector('[data-close-menu]')?.addEventListener('click', () => menu?.close());
    menu?.addEventListener('close', () => menuBtn?.setAttribute('aria-expanded', 'false'));
    if (menu) swipeToClose(menu, 'x', { edge: true });
    matchMedia('(min-width: 1200px)').addEventListener('change', (e) => { if (e.matches) menu?.close(); });

    // Video: load youtube-nocookie only on click
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.video-btn') as HTMLElement | null;
      if (!btn) return;
      const id = btn.dataset.yt; if (!id || !/^[\w-]+$/.test(id)) return;
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.title = 'YouTube video';
      btn.replaceWith(f);
    });

    // Forms on this copy do not collect data: continue on the organisation's own form.
    document.querySelectorAll('main form').forEach((form) => {
      form.addEventListener('submit', (e) => { e.preventDefault(); window.location.href = body.dataset.original || 'https://olympians.org/'; });
    });

    // Search (Pagefind, static index)
    const dlg = document.getElementById('search') as HTMLDialogElement;
    const input = document.getElementById('sd-q') as HTMLInputElement;
    const out = dlg.querySelector('.sd-results') as HTMLElement;
    let pf: any = null; let pfLoading: Promise<any> | null = null; let seq = 0; let timer = 0;
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    const loadPf = () => pfLoading ??= import(/* @vite-ignore */ `${BASE}/pagefind/pagefind.js`).then(async (m) => { await m.options({ excerptLength: 22 }); m.init(); pf = m; return m; }).catch(() => { pfLoading = null; return null; });
    const open = () => { dlg.showModal(); input.focus(); loadPf(); };
    document.querySelectorAll('[data-open-search]').forEach((b) => b.addEventListener('click', open));
    document.querySelector('[data-close-search]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    swipeToClose(dlg, 'y');
    document.addEventListener('keydown', (e) => { if (e.key === '/' && !dlg.open && !(e.target as HTMLElement).closest('input,textarea,select')) { e.preventDefault(); open(); } });
    const TYPE_ORDER: Record<string, number> = { Page: 0, 'Best Practice': 2, News: 3 };
    async function run(q: string) {
      const my = ++seq;
      if (q.trim().length < 2) { out.innerHTML = ''; return; }
      const m = pf || (await loadPf()); if (my !== seq) return;
      if (!m) { out.innerHTML = ''; return; }
      const res = await m.search(q); if (my !== seq) return;
      const data = await Promise.all(res.results.slice(0, 30).map((r: any) => r.data())); if (my !== seq) return;
      const ql = q.trim().toLowerCase();
      data.sort((a: any, b: any) => {
        const ea = (a.meta.title || '').toLowerCase() === ql ? -10 : 0, eb = (b.meta.title || '').toLowerCase() === ql ? -10 : 0;
        return (ea + (TYPE_ORDER[a.meta.type] ?? 1)) - (eb + (TYPE_ORDER[b.meta.type] ?? 1));
      });
      document.dispatchEvent(new CustomEvent('woa:search', { detail: { q, n: res.results.length } }));
      if (!data.length) { out.innerHTML = `<p class="sd-empty">${document.body.dataset.noResults || 'No results'}</p>`; return; }
      out.innerHTML = `<ul>${data.slice(0, 20).map((d: any) => `<li><a href="${esc(d.url)}"><span class="sd-type">${esc(d.meta.type || '')}</span><span class="sd-title">${esc(d.meta.title || '')}</span><span class="sd-ex">${d.excerpt}</span></a></li>`).join('')}</ul>`;
    }
    input.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(() => run(input.value), 160); });
  </script>
  <style is:global>
    .skip { position: absolute; left: 16px; top: -60px; z-index: 100; padding: 10px 16px; background: var(--c-black); color: var(--c-white); border-radius: var(--radius); }
    .skip:focus { top: 12px; }
    .search-dialog { width: min(760px, calc(100% - 24px)); max-height: min(80vh, 760px); margin: 8vh auto auto; padding: 0; border: 0; border-radius: var(--radius-lg); box-shadow: 0 24px 64px rgba(0, 0, 0, .3); }
    .search-dialog::backdrop { background: rgba(0, 0, 0, .55); }
    .sd-box { display: flex; flex-direction: column; max-height: inherit; }
    .sd-form { display: flex; align-items: center; gap: 12px; padding: 10px 10px 10px 20px; border-bottom: 1px solid var(--c-grey-200); }
    .sd-form input { flex: 1; min-width: 0; border: 0; outline: none; font-size: 1.25rem; padding: 12px 0; background: transparent; }
    .sd-form input::-webkit-search-cancel-button { display: none; }
    .sd-results { overflow-y: auto; }
    .sd-results ul { list-style: none; margin: 0; padding: 8px; }
    .sd-results a { display: grid; gap: 4px; padding: 14px 16px; border-radius: var(--radius); transition: background var(--t); }
    .sd-results a:hover, .sd-results a:focus-visible { background: var(--c-grey-50); }
    .sd-type { font-size: var(--fs-xs); font-weight: 600; color: var(--c-grey-600); }
    .sd-title { font-weight: 700; line-height: 1.3; }
    .sd-ex { font-size: var(--fs-small); color: var(--c-grey-700); }
    .sd-ex mark { background: rgba(182, 166, 127, .45); color: inherit; padding: 0 1px; }
    .sd-empty { padding: 24px; color: var(--c-grey-600); }
  </style>
  <script>
    // Custom scroll bar on wide screens with a mouse: a gold "OLY" disc rides a thin rail, can be dragged, the rail can be clicked.
    // Moving fast stretches the disc into a pill that springs back; a ring around it fills with progress; dots on the rail mark
    // the page's sections and light up once passed. Keyboard, wheel and touch scrolling stay native; phones keep the system bar.
    const bar = document.querySelector<HTMLElement>('.scrollbar');
    const mq = matchMedia('(min-width: 1024px) and (pointer: fine)');
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (bar && !navigator.webdriver) {
      const thumb = bar.querySelector<HTMLElement>('.sb-thumb')!;
      const pct = bar.querySelector<HTMLElement>('.sb-pct')!;
      const dotsBox = bar.querySelector<HTMLElement>('.sb-dots')!;
      const root = document.documentElement;
      let raf = 0, lastY = scrollY, lastT = performance.now(), idle = 0;
      let marks: { k: number; el: HTMLElement }[] = [];
      const max = () => root.scrollHeight - innerHeight;
      const layoutDots = () => {
        const m = max(); dotsBox.textContent = ''; marks = [];
        if (m <= 0) return;
        const secs = [...document.querySelectorAll<HTMLElement>('main > section, main > article, main .article > section')].filter(s => s.offsetHeight > innerHeight * 0.35);
        for (const s of secs.slice(1, 16)) {
          const k = Math.min(1, Math.max(0, (s.getBoundingClientRect().top + scrollY - innerHeight * 0.3) / m));
          const d = document.createElement('i'); d.style.setProperty('--p', k.toFixed(4)); dotsBox.append(d); marks.push({ k, el: d });
        }
      };
      const paint = () => {
        raf = 0; const m = max(); const k = m > 0 ? Math.min(1, scrollY / m) : 0;
        bar.style.setProperty('--k', k.toFixed(4)); bar.hidden = m < 40;
        pct.textContent = Math.round(k * 100) + '%';
        for (const d of marks) d.el.classList.toggle('on', k >= d.k - 0.002);
        // speed -> stretch (px), springs back when scrolling stops
        const now = performance.now(); const v = Math.abs(scrollY - lastY) / Math.max(16, now - lastT); lastY = scrollY; lastT = now;
        if (!calm && v > 0.05) { bar.style.setProperty('--st', Math.min(36, v * 14).toFixed(1) + 'px'); bar.classList.add('moving'); clearTimeout(idle); idle = window.setTimeout(() => { bar.classList.remove('moving'); bar.style.setProperty('--st', '0px'); }, 140); }
      };
      const queue = () => { if (!raf) raf = requestAnimationFrame(paint); };
      const on = () => root.classList.toggle('has-sb', mq.matches);
      on(); mq.addEventListener('change', on);
      addEventListener('scroll', queue, { passive: true });
      addEventListener('resize', () => { layoutDots(); queue(); });
      new ResizeObserver(() => { layoutDots(); queue(); }).observe(document.body);
      addEventListener('load', () => { layoutDots(); queue(); });
      layoutDots(); paint();
      requestAnimationFrame(() => bar.classList.add('sb-in'));
      const toY = (clientY: number) => { const r = bar.getBoundingClientRect(); const t = thumb.offsetWidth; const k = Math.min(1, Math.max(0, (clientY - r.top - t / 2) / (r.height - t))); scrollTo({ top: k * max(), behavior: 'instant' as ScrollBehavior }); };
      bar.addEventListener('pointerdown', (e) => {
        e.preventDefault(); bar.setPointerCapture(e.pointerId); bar.classList.add('dragging'); toY(e.clientY);
        const move = (ev: PointerEvent) => toY(ev.clientY);
        const up = () => { bar.classList.remove('dragging'); bar.removeEventListener('pointermove', move); bar.removeEventListener('pointerup', up); bar.removeEventListener('pointercancel', up); };
        bar.addEventListener('pointermove', move); bar.addEventListener('pointerup', up); bar.addEventListener('pointercancel', up);
      });
    }
  </script>
  {import.meta.env.PUBLIC_CMS_URL && <script is:inline define:vars={{ cms: import.meta.env.PUBLIC_CMS_URL.replace(/\/$/, ''), base: import.meta.env.BASE_URL.replace(/\/$/, '') }}>
    // Visit counter for the CMS (Analytics in WOA Admin): no cookies, no IP, no personal data; off with Do Not Track / Global Privacy Control.
    // Sends: the page view (language, source, time zone for the country, screen width, local hour), and when the tab is hidden the time on page,
    // scroll depth and loading speed (LCP, INP, CLS); clicks on downloads, external links and videos; site search terms; addresses that gave 404.
    (function () {
      if (navigator.doNotTrack === '1' || navigator.globalPrivacyControl || /bot|headless/i.test(navigator.userAgent) || navigator.webdriver) return;
      var rnd = function () { return Math.random().toString(36).slice(2, 12) + Date.now().toString(36); };
      var fresh = false;
      var keep = function (store, k, mark) { try { var v = store.getItem(k); if (!v) { v = rnd(); store.setItem(k, v); if (mark) fresh = true; } return v; } catch (e) { return rnd(); } };
      var v = keep(localStorage, 'woa-v', true), s = keep(sessionStorage, 'woa-s'), e = rnd(), t0 = Date.now(), hidden = 0, hid = 0;
      var path = location.pathname.slice(base.length) || '/';
      var ref = '', from = ''; try { var r = new URL(document.referrer); if (r.host !== location.host) ref = r.host; else from = r.pathname.slice(base.length) || '/'; } catch (x) {}
      var send = function (o) { var b = new URLSearchParams(Object.assign({ p: path, v: v, s: s, e: e }, o)); try { navigator.sendBeacon(cms + '/api/woa/track', b); } catch (x) {} };
      var q = new URLSearchParams(location.search), now = new Date(), tz = '';
      try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (x) {}
      var notFound = !!document.querySelector('[data-notfound]');
      send({ k: notFound ? 'notfound' : 'pageview', t: document.title.replace(/ \|.*$/, ''), l: document.documentElement.lang || 'en', r: ref, f: from, z: tz,
        w: String(Math.round(innerWidth)), hr: String(now.getHours()), wd: String(now.getDay()), n: fresh ? '1' : '',
        us: q.get('utm_source') || '', um: q.get('utm_medium') || '', uc: q.get('utm_campaign') || '' });
      if (notFound) return;
      var depth = 0, lcp = 0, cls = 0, inp = 0;
      var measure = function () { var h = document.documentElement.scrollHeight - innerHeight; depth = Math.max(depth, h > 0 ? Math.min(100, Math.round(scrollY / h * 100)) : 100); };
      measure(); addEventListener('scroll', measure, { passive: true });
      var watch = function (type, fn, opt) { try { new PerformanceObserver(function (l) { l.getEntries().forEach(fn); }).observe(Object.assign({ type: type, buffered: true }, opt || {})); } catch (x) {} };
      watch('largest-contentful-paint', function (x) { lcp = Math.round(x.startTime); });
      watch('layout-shift', function (x) { if (!x.hadRecentInput) cls += x.value; });
      watch('event', function (x) { if (x.interactionId) inp = Math.max(inp, Math.round(x.duration)); }, { durationThreshold: 40 });
      var report = function () { send({ k: 'time', d: String(Date.now() - t0 - hidden - (hid ? Date.now() - hid : 0)), sd: String(depth), lcp: String(lcp), cls: String(Math.round(cls * 1000)), inp: String(inp) }); };
      document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') { hid = Date.now(); report(); }
        else if (hid) { hidden += Date.now() - hid; hid = 0; }
      });
      addEventListener('pagehide', report);
      document.addEventListener('click', function (ev) {
        var el = ev.target.closest ? ev.target : null; if (!el) return;
        var vid = el.closest('.video-btn'); if (vid) { send({ k: 'video', h: vid.getAttribute('data-yt') || '' }); return; }
        var a = el.closest('a[href]'); if (!a) return;
        var href = a.getAttribute('href') || '';
        if (/\.(pdf|docx?|xlsx?|pptx?|zip)(\?|#|$)/i.test(href)) send({ k: 'download', h: a.href.replace(location.origin, '') });
        else if (/^(mailto|tel):/i.test(href) || (a.host && a.host !== location.host)) send({ k: 'outbound', h: a.href.slice(0, 300) });
        else if (href.charAt(0) !== '#') report();
      }, true);
      var st = 0;
      document.addEventListener('woa:search', function (ev) {
        clearTimeout(st); var d = ev.detail || {};
